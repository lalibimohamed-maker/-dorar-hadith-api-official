{
  "schemaVersion":"1.0.0",
  "assistantName":"يا بوابة العلم",
  "purpose":"Local-first Arabic voice interaction governance for Deen Allah Encyclopedia.",
  "principles":{
    "localFirst":true,
    "explicitMicrophoneConsent":true,
    "rawAudioNotAuthoritativeContent":true,
    "preserveProvenance":true,
    "noBackgroundRecordingByDefault":true,
    "failClosedOnUnknownModelRights":true,
    "noPaidApiRequired":true
  },
  "pipeline":{
    "wakeWord":{"primary":"openWakeWord","status":"assess_for_arabic","requiredCustomModel":"ya_bawabat_al_ilm"},
    "resourceConstrainedWakeWord":{"primary":"micro-wake-word","status":"trial"},
    "vad":{"primary":"silero-vad","status":"adopt"},
    "stt":{"primary":"whisper.cpp","alternates":["faster-whisper"],"status":"adopt"},
    "denoise":{"primary":"DeepFilterNet","alternate":"RNNoise","selection":"benchmark_by_device"},
    "tts":{"primary":"Piper1-GPL","arabicVoice":"ar_JO","status":"adopt_with_voice_license_check"},
    "webFallback":{"primary":"Web Speech API","status":"fallback_only"}
  },
  "wakeWordQualityGates":{
    "testArabicAccents":true,
    "falseAcceptRateRequired":true,
    "falseRejectRateRequired":true,
    "noiseScenariosRequired":true,
    "musicSpeechOverlapRequired":true,
    "multiSpeakerRequired":true,
    "noDefaultProductionPromotionWithoutBenchmark":true
  },
  "privacy":{
    "permission":"required",
    "secureContext":"required",
    "permissionsPolicy":"microphone=(self)",
    "backgroundListening":"off_by_default",
    "rawAudioRetention":"off_by_default",
    "rawAudioUpload":"prohibited_without_explicit_user_action",
    "serverProcessing":"explicit_consent_required",
    "microphoneIndicator":"required",
    "stopControl":"always_available"
  },
  "settings":{
    "wakeWordEnabled":false,
    "wakeWordSensitivity":"user_selectable",
    "language":"user_selectable",
    "locale":"user_selectable",
    "voice":"user_selectable",
    "speechRate":"user_selectable",
    "pitch":"user_selectable",
    "noiseSuppression":"adaptive",
    "localOnlyMode":true,
    "saveRecordings":false
  },
  "rights":{
    "engineLicenseChecked":true,
    "modelCardRequired":true,
    "voiceLicenseRequiredPerModel":true,
    "unknownRights":"do_not_distribute"
  },
  "deployment":{
    "browser":"PWA_preferred",
    "mobile":"native_or_pwa_with_platform_permission",
    "desktop":"local_service_or_pwa",
    "deviceSettingsIntegration":"where_platform_allows",
    "offline":"preferred"
  },
  "browserConstraints":{
    "getUserMediaRequiresSecureContext":true,
    "webSpeechRecognitionIsNotSoleBackend":true,
    "onDeviceSpeechPreferredWhenAvailable":true,
    "webSpeechCompatibilityCheckedAtRuntime":true
  }
}
