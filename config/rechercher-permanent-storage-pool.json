{
  "schema": "din-allah-encyclopedia/permanent-storage-pool/v2",
  "policy": "append-only; real .pdf Release assets only; SHA-256 identity; never delete, overwrite, replace, or rename an existing published asset",
  "storage_model": "github-releases-only",
  "repository": "lalibimohamed-maker/dinullah-matrix-6384-storage-01",
  "role": "unified-6,384-matrix-release-storage",
  "routing": {
    "identity": "sha256",
    "same_sha": "keep-existing",
    "different_sha": "append-new-independent-pdf",
    "rights_unclear": "protected-private-only",
    "release_target": "main",
    "public_release_requires_item_level_rights_and_provenance": true,
    "never_route_before_rights_verification": true,
    "fail_closed_if_release_storage_is_not_accessible": true,
    "never_delete_or_move_existing_assets": true
  },
  "central_index": {
    "required": true,
    "record_fields": [
      "sha256",
      "storage_repository",
      "release",
      "asset",
      "bytes",
      "validation",
      "acquisition_date",
      "acquisition_run",
      "book_id",
      "work_id",
      "edition_id",
      "rights_status"
    ]
  }
}
