{
  "schema": "din-allah-encyclopedia/permanent-storage-pool/v2",
  "policy": "GitHub Releases asset storage; real .pdf only; SHA-256 identity; repository tree contains indexes only.",
  "backend": "github-releases-assets",
  "git_lfs": false,
  "github_actions_artifacts_as_pdf_storage": false,
  "encrypted_final_artifacts": false,
  "primary": {
    "id": "release-public",
    "repository": "lalibimohamed-maker/-dorar-hadith-api-official",
    "status": "active",
    "role": "public-publication-eligible-pdf-releases"
  },
  "protected": {
    "id": "release-protected",
    "repository": "lalibimohamed82-coder/rechercher-pdf-storage",
    "status": "active-when-private",
    "role": "rights-unclear-or-restricted-pdf-releases"
  },
  "routing": {
    "identity": "sha256",
    "same_sha": "keep-existing",
    "different_sha": "keep as independently identified edition only when metadata distinguishes it",
    "rights_unclear": "protected-private-release-only",
    "public_eligible": "public-release-only",
    "repository_tree_pdf": false,
    "one_release_asset_per_pdf": true
  },
  "central_index": {
    "required": true,
    "fields": ["sha256", "release_tag", "release_repository", "download_url", "bytes", "validation", "acquisition_date", "acquisition_run", "book_id", "work_id", "edition_id", "rights_status", "access"]
  }
}
