{
  "schema_version": "1.1.0",
  "policy": {
    "default_mode": "auto",
    "offline_only_must_never_require_network": true,
    "online_is_explicit_alternative": true,
    "online_fallback_is_allowed_only_in_auto_mode": true,
    "corpus_write_allowed": false,
    "generated_media_is_evidence": false,
    "scholarly_truth_scope": "verified_corpus_only"
  },
  "local_runtime": {
    "browser": {
      "inference": [
        "Transformers.js",
        "ONNX Runtime Web",
        "WebAssembly",
        "WebGPU"
      ],
      "search": [
        "Orama",
        "USearch"
      ],
      "relations": [
        "DuckDB-Wasm",
        "SQLite-Wasm-compatible adapter"
      ],
      "inference_policy": {
        "onnx_models_only": true,
        "remote_model_downloads": false,
        "local_files_only": true
      }
    },
    "desktop": {
      "llm": [
        "llama.cpp"
      ],
      "model_formats": [
        "GGUF",
        "ONNX"
      ],
      "gguf_note": "GGUF is handled by llama.cpp, not ONNX Runtime Web"
    },
    "speech": [
      "sherpa-onnx"
    ]
  },
  "model_policy": {
    "offline_artifact_requires": [
      "sha256_verified",
      "revision_verified",
      "license_verified",
      "estimated_peak_ram_bytes"
    ],
    "quantization": [
      "q4",
      "q8",
      "int8",
      "fp16"
    ],
    "no_unverified_weight_loading": true,
    "no_git_lfs": true,
    "release_asset_distribution": "github-releases"
  },
  "device_policy": {
    "browser_model_budget_fraction": 0.35,
    "default_safety_reserve_bytes": 268435456,
    "never_assume_that_file_size_equals_peak_ram": true,
    "device_memory_is_approximate": true,
    "effective_cap_is_min_of_known_caps": true,
    "required_memory_includes_runtime_index_tokenizer_buffers_and_safety": true,
    "platform_process_cap_bytes": null,
    "native_webview_cap_bytes": null,
    "4gb_devices_are_not_promised_to_run_1_8gb_models": true
  },
  "distribution_policy": {
    "release_asset_distribution": "github-releases",
    "git_lfs_allowed": false,
    "http_range_resume": true,
    "range_resume_requires_206": true,
    "range_resume_requires_content_range": true,
    "resume_validator": [
      "etag",
      "last-modified"
    ],
    "block_hash_verification": true,
    "default_block_size_bytes": 16777216
  },
  "validated_tool_versions": {
    "onnxruntime-web": "1.30.0",
    "@huggingface/transformers": "4.3.0",
    "@orama/orama": "3.1.18",
    "usearch": "2.26.2",
    "@duckdb/duckdb-wasm": "1.5.5",
    "sherpa-onnx": "1.13.8"
  }
}
