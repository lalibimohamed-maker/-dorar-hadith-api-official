{
  "schema_version": "1.0.0",
  "purpose": "Open multimodal model registry for Rechercher Ω. Models are interchangeable workers, never scholarly sources.",
  "selection_policy": {
    "principles": [
      "Prefer local/open implementations over paid APIs.",
      "Treat code license and model-weight license as separate fields.",
      "Never infer license permissions from repository visibility alone.",
      "Never let generated media become evidence for a scholarly claim.",
      "Route by task, resource budget, provenance and quality gates."
    ]
  },
