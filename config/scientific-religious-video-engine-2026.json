      "scientific_visualization",
      "3d_explanatory_scene",
      "map",
      "diagram",
      "animation",
      "simulation",
      "original_illustration"
    ],
    "candidateModelsOnly": true,
    "modelPromotionIndependentOfMediaPromotion": true
  },
  "quranSynchronization": {
    "quranArabicText": "verbatim_source_bound",
    "translationMeanings": "distinct_assets",
    "recitationRightsRequired": true,
    "wordLevelModeRequires": [
