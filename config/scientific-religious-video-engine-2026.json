      }
    ],
    "rendering_and_transcode": [
      {
        "name": "FFmpeg",
        "status": "candidate",
        "softwareLicense": "LGPL/GPL depending on build and enabled components",
        "rightsGate": "record_exact_build_configuration",
        "source": "https://ffmpeg.org/"
      }
    ],
    "image_restoration": [
      {
        "name": "Real-ESRGAN",
        "status": "license_gated",
        "softwareOrModelLicense": "verify_current_project_and_each_weight",
        "source": "https://github.com/xinntao/Real-ESRGAN"
      }
    ]
  },
  "outputProfiles": {
    "720p": {
      "maxWidth": 1280,
      "maxHeight": 720
    },
    "1080p": {
      "maxWidth": 1920,
      "maxHeight": 1080
    },
    "1440p": {
      "maxWidth": 2560,
      "maxHeight": 1440
    },
    "4K": {
      "maxWidth": 3840,
      "maxHeight": 2160
    },
    "8K": {
      "maxWidth": 7680,
      "maxHeight": 4320
    },
    "16K": {
      "maxWidth": 15360,
      "maxHeight": 8640
    },
    "32K": {
      "maxWidth": 30720,
      "maxHeight": 17280
    },
    "48K": {
      "maxWidth": 46080,
      "maxHeight": 25920
    }
  },
  "outputPolicy": {
    "maximumHorizontalPixels": 46080,
    "maximumVerticalPixels": 25920,
    "maximumLandscapeProfile": "46080x25920",
    "maximumPortraitProfile": "25920x46080",
    "renderStrategy": "multi_stage_generate_align_compose_restore_upscale_encode",
    "importantConstraint": "48K is an output/render ceiling, not a claim that every generation model produces native 48K frames.",
    "qualityRequirement": "Upscaling may not invent or alter Quran text, hadith text, scientific labels, citations, or factual diagrams; text-bearing layers must be rendered from source vectors at final resolution."
  },
  "assetPolicy": {
    "sourceClasses": [
      "public_domain",
      "compatible_open_license",
      "explicit_permission",
      "original_generated",
      "reference_only_not_embeddable"
    ],
    "referenceOnlyMeans": "A discovered third-party video may inform research but cannot be embedded, redistributed or transformed unless the rights gate permits it.",
    "manifestFields": [
      "assetId",
      "sourceUrl",
      "creator",
      "license",
      "licenseEvidence",
      "retrievedAt",
      "sha256",
      "usageScope",
      "attribution",
      "modelOrTool",
      "modelVersion"
    ]
  },
  "promotionPolicy": {
    "automaticRuntimePromotion": false,
    "automaticCorpusMutation": false,
    "gates": [
      "rights",
      "evidence_verification",
      "scientific_religious_integrity",
      "security",
      "arabic_quality",
      "audiovisual_quality",
      "performance_resource_cost",
      "provenance",
      "human_review",
      "CI"
    ],
    "productionUseRequires": [
      "rights_verified",
      "evidence_verified",
      "scientific_religious_integrity_passed",
      "security_passed",
      "arabic_quality_passed",
      "audiovisual_quality_passed",
      "performance_resource_cost_passed",
      "provenance_manifest_complete",
      "human_review",
      "CI_passed"
    ],
    "noAutomaticPromotionOf": [
      "video_models",
      "voice",
      "footage_sources",
      "renderers"
    ]
  },
  "runtimeBoundary": {
    "registryOnly": true,
    "runtimeDependency": false,
    "canonicalCorpusMutation": false,
    "automaticModelOrMediaPromotion": false,
    "generatedOutputCannotBecomeCanonicalByDefault": true
  },
  "claimPolicy": {
    "separatedClaimTypes": [
      "quran_text",
      "quran_translation_meaning",
      "quran_tafsir",
      "hadith_text",
      "hadith_grading",
      "scientific_observation",
      "scientific_consensus",
      "scientific_hypothesis",
      "historical_report",
      "interpretive_relationship"
    ],
    "requiredForEveryScene": [
      "claimIds",
      "evidenceIds"
    ],
    "relationStrengthMustBeExplicit": true,
    "interpretiveRelationshipCannotBecomeScientificFact": true,
    "interpretiveRelationshipCannotBecomeReligiousRuling": true,
    "unsupportedScientificClaimBlocksFinalTimeline": true,
    "unsupportedReligiousClaimBlocksFinalTimeline": true
  },
  "sceneContract": {
    "sceneMustReferenceClaimEvidence": true,
    "fields": [
      "sceneId",
      "purpose",
      "claimIds",
      "evidenceIds",
      "visualSource",
      "rightsState",
      "assetIds",
      "timelineRange"
    ],
    "thirdPartyVideoDefault": "reference-only-until-media-rights-verified",
    "publicOnInternetDoesNotMeanReusable": true
  },
  "mediaRightsPolicy": {
    "embeddableClasses": [
      "public_domain",
      "compatible_open_license",
      "explicit_permission",
      "original_generated"
    ],
    "thirdPartySearchResultDefault": "reference_only_not_embeddable",
    "permissionRequiredBeforeTransformOrRedistribution": true,
    "licenseAndPermissionStoredPerAsset": true
  },
  "originalCreationPolicy": {
    "preferredWhenClearedFootageUnavailable": true,
    "allowedVisualTypes": [
      "scientific_visualization",
      "3d_explanatory_scene",
      "map",
      "diagram",
      "animation",
      "simulation",
      "original_illustration"
    ],
    "candidateModelsOnly": true,
    "modelPromotionIndependentOfMediaPromotion": true
  },
  "quranSynchronization": {
    "quranArabicText": "verbatim_source_bound",
    "translationMeanings": "distinct_assets",
    "recitationRightsRequired": true,
    "wordLevelModeRequires": [
      "rights_cleared_recitation",
      "trusted_word_or_character_timing"
    ],
    "fallbackMode": "ayah_level",
    "timingsDrive": [
      "word_highlighting",
      "pronunciation_linked_animation",
      "translation_timing",
      "accessibility_captions"
    ],
    "noTextMutationDuringAlignment": true
  },
  "renderArchitecture": {
    "stages": [
      "evidence_and_storyboard",
      "generation_or_lawful_media_acquisition",
      "scene_analysis",
      "composition",
      "quran_hadith_translation_audio_synchronization",
      "text_vector_render_at_target_resolution",
      "eligible_raster_restoration_upscaling",
      "final_encode",
      "provenance_manifest"
    ],
    "landscape48K": "46080x25920",
    "portrait48K": "25920x46080",
    "outputCeilingOnly": true,
    "native48KGenerationNotRequired": true,
    "textQuranCitationsAndFactualDiagramsRenderedAsFinalResolutionVectorOrText": true,
    "repeatedRasterUpscalingOfTextForbidden": true
  },
  "reproducibility": {
    "deterministicTimelineManifest": true,
    "rebuildWhenEvidenceChanges": true,
    "rebuildWhenLicenseChanges": true,
    "rebuildWhenTranslationChanges": true,
    "assetProvenanceRequired": [
      "visual",
      "audio",
      "model",
      "citation"
    ],
    "requiredPerAssetFields": [
      "assetId",
      "sourceUrl",
      "creator",
      "license",
      "licenseEvidence",
      "retrievedAt",
      "sha256",
      "usageScope",
      "attribution",
      "modelOrTool",
      "modelVersion"
    ]
  },
