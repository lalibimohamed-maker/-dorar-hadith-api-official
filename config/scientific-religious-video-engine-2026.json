      "sourceUrl",
      "creator",
      "license",
      "licenseEvidence",
      "retrievedAt",
      "sha256",
      "usageScope",
      "attribution",
      "modelOrTool",
      "modelVersion"
    ]
  },
  "promotionPolicy": {
    "automaticRuntimePromotion": false,
    "automaticCorpusMutation": false,
    "gates": [
      "rights",
