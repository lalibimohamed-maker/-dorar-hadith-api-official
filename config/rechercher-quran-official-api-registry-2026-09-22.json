{
  "registry_version": "2026-09-22",
  "purpose": "Official Quran API and developer-source discovery for Rechercher. This registry records access capabilities without granting Corpus write authority.",
  "policy": {
    "canonical_arabic_text_is_separate_from_translations": true,
    "api_access_does_not_equal_redistribution_rights": true,
    "source_identity_does_not_certify_each_item": true,
    "direct_corpus_write": false,
    "provenance_required": true,
    "rights_verification_required": true,
    "ai_generated_religious_text_forbidden_as_source": true,
    "qiraat_are_distinct_canonical_readings_and_must_not_be_collapsed_into_one_text": true,
    "tajweed_annotations_are_not_a_replacement_for_canonical_quran_text": true,
    "tafsir_is_separate_from_canonical_quran_text": true
  },
  "verified": [
