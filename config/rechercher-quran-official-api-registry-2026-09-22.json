      },
      "canonical_text_policy": "Arabic Quran text remains distinct from translations, tafsir, tajweed annotations, and qiraat-specific representations",
      "integration_status": "adapter-present; production credentials/access still require verification",
      "corpus_write": "forbidden-direct"
    },
