        "status": "verified",
        "endpoint_family": "content-v4-uthmani-tajweed-and-mushaf",
        "notes": "Official API exposes text_uthmani_tajweed and Tajweed-colored Mushaf variants."
      },
      "qiraat_api": {
        "status": "not-verified-as-ten-readings-api",
