{
  "schema_version": "1.0.0",
  "engine": "rechercher-omega",
  "module": "global-deep-search",
  "purpose": "Worldwide source discovery and query-plan generation for Rechercher Ω.",
  "mode": "discovery_and_planning",
  "principles": [
    "Generate source candidates and search queries; never treat discovery as proof.",
    "Use the existing source registry and global ingestion queue as the seed graph.",
    "Search by country, region, language, institution, domain family and source type.",
    "Preserve original source identity, language, edition, rights and provenance.",
    "No arbitrary AI URL fetching.",
    "No direct Corpus writes.",
    "Unknown rights remain review_required or blocked."
  ],
  "language_facets": [
    "ar","en","fr","ru","tr","ur","fa","id","ms","de",
    "es","pt","it","zh","ja","ko","bn","sw","ha","ta"
  ],
  "source_families": [
    "official_government",
    "official_quran",
    "university",
    "national_library",
    "digital_library",
    "manuscript_catalog",
    "research_center",
    "fatwa",
    "publisher",
    "open_archive",
    "bibliographic_index",
    "scholarly_portal",
    "book_catalog",
    "api",
    "repository"
  ],
  "search_layers": [
    "exact_title_author",
    "title_variants",
    "author_variants",
    "transliteration",
    "language_localization",
    "country_institution",
    "catalog_identifier",
    "edition_volume",
    "file_type",
    "rights_and_access"
  ],
  "output_contract": {
    "must_include": [
      "query_id",
      "query",
      "language",
      "region_or_country",
      "source_family",
      "intent",
      "priority",
      "rights_required",
      "evidence_required"
    ],
    "corpus_write_allowed": false,
    "generated_media_is_evidence": false
  }
}
