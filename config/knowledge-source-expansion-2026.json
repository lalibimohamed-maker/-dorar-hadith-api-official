  "rules": {
    "tierA": "النصوص الأصلية والمصادر المبكرة أو الموسوعات التي صرحت منهجيتها بالتحقيق والتوثيق.",
    "tierB": "مصادر علمية مهمة وجامعة تستعمل للمقارنة ولا تستقل بالحسم عند التعارض.",
    "tierC": "مصادر مساعدة أو متأخرة أو حديثة تحتاج إلى تحقق إضافي.",
    "historical": "الخبر التاريخي لا يصبح صحيحًا لمجرد وروده في كتاب تاريخ.",
    "genealogy": "النسب المتنازع فيه يعرض بأقوال مصادره وتواريخها ودرجة قربها، ولا يحسم من مصدر واحد.",
    "prophets": "القرآن والسنة الصحيحة مقدمان، وتفصل الإسرائيليات والأخبار الضعيفة عن الحقائق الثابتة.",
    "companions": "ثبوت الصحبة شيء، وصحة كل خبر يروى عن الصحابي شيء آخر.",
    "fiqh": "يعرض المذهب ومأخذه وأدلة الأقوال والقول الراجح عند توفر تحرير علمي، مع نسبة الترجيح وعدم نسبته إلى عالم بلا نص.",
    "scholars": "إدراج العالم يعني صلاحيته كمصدر بحثي في تخصصه وفق التوثيق المتاح، ولا يعني الموافقة على جميع أقواله."
  }
