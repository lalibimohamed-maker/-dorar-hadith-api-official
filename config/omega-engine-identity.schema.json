{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dinullah.org/schemas/omega-engine-identity.schema.json",
  "title": "Rechercher Omega Engine Identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "engine_id",
    "model_id",
    "revision",
    "runtime",
    "artifact",
    "license",
    "rights_state",
    "activation_state"
  ],
  "properties": {
    "engine_id": { "type": "string", "minLength": 1 },
    "model_id": { "type": "string", "minLength": 1 },
    "revision": { "type": "string", "minLength": 1 },
    "runtime": { "type": "string", "minLength": 1 },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "reference": { "type": "string", "minLength": 1 },
        "sha256": { "type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$" }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "status"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["verified_source_license", "review_required", "blocked"]
        }
      }
    },
    "rights_state": {
      "enum": ["public_allowed", "private_only", "review_required", "blocked"]
    },
    "activation_state": {
      "enum": ["registered", "installed", "verified", "active", "blocked"]
    }
  }
}
