{
  "schemaVersion": "2.3.0",
  "verifiedAt": "2026-09-26",
  "baseMain": "52f5567ddd226cf7f45b0ed6bb779b5391878607",
  "purpose": "Continuous, measurable evaluation of free-first and self-hosted engines without changing canonical scholarly content.",
  "principles": {
    "freeFirst": true,
    "paidApiRequired": false,
    "subscriptionRequired": false,
    "selfHostedPreferred": true,
    "noArtificialApplicationCeiling": true,
    "measureBeforePromotion": true,
    "humanReviewBeforeAdoption": true,
    "preserveOriginal": true,
    "preserveCorpusAndProvenance": true,
    "failClosedOnUnknownRights": true,
    "softwareLicenseDistinctFromModelLicense": true,
    "modelLicenseDistinctFromVoiceLicense": true,
    "hostedPricingDistinctFromSoftwareLicense": true
  },
  "evaluationGates": [
    "software_license",
    "model_or_weight_license",
    "voice_or_asset_license",
    "hosted_service_pricing",
    "security",
    "maintenance_health",
    "release_activity",
    "arabic_quality",
    "performance",
    "resource_cost",
    "offline_self_hosting",
    "reproducibility",
    "provenance",
    "rights",
    "human_review"
  ],
  "statusDefinitions": {
    "adopted": "Already selected as a production-capable primary; still continuously evaluated.",
    "candidate": "Eligible for benchmark and review; not a production dependency by this registry.",
    "license_gated": "Technically relevant but cannot be promoted until every relevant artifact/model/voice license is verified.",
    "watch": "Observed for future capability or replacement evidence."
  },
  "engines": {
    "ocr": {
      "primary": "paddleocr",
      "alternates": [
        "tesseract",
        "kraken"
      ],
      "status": "candidate",
      "versionReference": "3.7.0",
      "softwareLicense": "Apache-2.0",
      "modelLicense": "verify_per_model",
      "watch": "Arabic OCR accuracy, degraded scans, tables, layout, CPU/mobile performance",
      "source": "https://github.com/PaddlePaddle/PaddleOCR"
    },
    "search_text": {
      "primary": "opensearch",
      "alternates": [
        "meilisearch"
      ],
      "status": "candidate",
      "versionReference": "3.6.0",
      "softwareLicense": "Apache-2.0",
      "modelLicense": "not_applicable",
      "watch": "Arabic lexical search, typo tolerance, hybrid retrieval, index size, latency",
      "source": "https://opensearch.org/"
    },
    "search_federated": {
      "primary": "searxng",
      "status": "candidate",
      "versionReference": "rolling",
      "softwareLicense": "AGPL-3.0-or-later",
      "modelLicense": "not_applicable",
      "watch": "engine availability, source terms, rate limits, privacy, result provenance",
      "source": "https://github.com/searxng/searxng"
    },
    "search_semantic": {
      "primary": "qdrant",
      "alternates": [
        "oxigraph"
      ],
      "status": "candidate",
      "versionReference": "1.18.x",
      "softwareLicense": "Apache-2.0",
      "modelLicense": "embedding_model_dependent",
      "watch": "hybrid recall, Arabic embeddings, latency, memory, filtering, provenance",
      "source": "https://github.com/qdrant/qdrant"
    },
    "knowledge_graph": {
      "primary": "oxigraph",
      "alternates": [
        "apache-jena"
      ],
      "status": "candidate",
      "versionReference": "rolling",
      "softwareLicense": "MIT OR Apache-2.0",
      "modelLicense": "not_applicable",
      "watch": "SPARQL correctness, graph growth, transaction behavior, query performance",
      "source": "https://github.com/oxigraph/oxigraph"
    },
    "translation": {
      "primary": "argostranslate",
      "alternates": [
        "libretranslate"
      ],
      "status": "candidate",
      "versionReference": "Argos 1.4.0 / LibreTranslate 1.9.6",
      "softwareLicense": "MIT / AGPL-3.0 respectively",
      "modelLicense": "verify_per_language_model",
      "watch": "Arabic fidelity, terminology, offline operation, model rights, resource cost",
      "source": "https://github.com/argosopentech/argos-translate"
    },
    "speech_to_text": {
      "primary": "whisper.cpp",
      "status": "candidate",
      "versionReference": "1.9.1",
      "softwareLicense": "MIT",
      "modelLicense": "Whisper_model_terms_must_be_verified_separately",
      "watch": "Arabic transcription, diacritics, streaming, CPU/Apple Silicon performance, timestamps",
      "source": "https://github.com/ggml-org/whisper.cpp"
    },
    "text_to_speech": {
      "primary": "piper1-gpl",
      "status": "license_gated",
      "versionReference": "1.4.2",
      "softwareLicense": "GPL-3.0",
      "modelLicense": "verify_per_voice_model",
      "watch": "Arabic voices, voice quality, latency, redistribution rights, model provenance",
      "source": "https://github.com/OHF-Voice/piper1-gpl"
    },
    "media_download": {
      "primary": "yt-dlp",
      "status": "license_gated",
      "versionReference": "2026.08.19",
      "softwareLicense": "Unlicense",
      "modelLicense": "not_applicable",
      "artifactLicense": "verify_packaged_artifact_components",
      "watch": "extractor health, source terms, checksums/signatures, packaged component licenses",
      "source": "https://github.com/yt-dlp/yt-dlp"
    },
    "image_restoration": {
      "primary": "real-esrgan",
      "alternates": [
        "swinir"
      ],
      "status": "license_gated",
      "versionReference": "0.3.0",
      "softwareLicense": "verify_current_project_license",
      "modelLicense": "verify_per_weight",
      "watch": "artifact rate, Arabic text legibility, source faithfulness, weight provenance"
    },
    "omega_support": {
      "purpose": "Rechercher Ω free-first support layer for semantic retrieval, reranking, agent safety, vector persistence, and tool routing.",
      "policy": {
        "paidApiRequired": false,
        "subscriptionRequired": false,
        "selfHostedPreferred": true,
        "runtimeOnlyWherePossible": true,
        "modelDownloadOptional": true,
        "failClosedOnUnknownRights": true,
        "softwareLicenseDistinctFromModelLicense": true
      },
      "components": [
        {
          "id": "embedding",
          "name": "Qwen3-Embedding-4B",
          "alternates": [
            "BAAI/bge-m3",
            "Alibaba-NLP/gte-Qwen2-1.5B-instruct"
          ],
          "role": "Convert Arabic and multilingual documents into dense vectors for semantic and hybrid retrieval.",
          "status": "candidate",
          "softwareLicense": "Apache-2.0",
          "modelLicense": "Apache-2.0",
          "source": "https://huggingface.co/Qwen/Qwen3-Embedding-4B",
          "alternatesLicense": {
            "BAAI/bge-m3": "MIT",
            "Alibaba-NLP/gte-Qwen2-1.5B-instruct": "verify_current_model_license"
          },
          "integration": {
            "feeds": [
              "search_semantic",
              "vector_storage"
            ],
            "recommendedDimension": 2560,
            "multilingual": true,
            "arabicSupported": true
          },
          "watch": "Arabic retrieval quality, memory footprint, CPU/GPU throughput, reproducibility, model provenance"
        },
        {
          "id": "reranking",
          "name": "Qwen3-Reranker",
          "alternates": [
            "Qwen/Qwen3-Reranker-0.6B",
            "Qwen/Qwen3-Reranker-4B",
            "Qwen/Qwen3-Reranker-8B",
            "BAAI/bge-reranker-v2-m3",
            "mixedbread-ai/mxbai-rerank-base-v2"
          ],
          "role": "Re-rank retrieved Quran verses, hadiths, scholarly passages, and other evidence before context assembly.",
          "status": "candidate",
          "softwareLicense": "Apache-2.0",
          "modelLicense": "Apache-2.0",
          "source": "https://huggingface.co/Qwen/Qwen3-Reranker-4B",
          "alternatesLicense": {
            "Qwen/Qwen3-Reranker-0.6B": "Apache-2.0",
            "Qwen/Qwen3-Reranker-4B": "Apache-2.0",
            "Qwen/Qwen3-Reranker-8B": "Apache-2.0",
            "BAAI/bge-reranker-v2-m3": "Apache-2.0",
            "mixedbread-ai/mxbai-rerank-base-v2": "Apache-2.0"
          },
          "integration": {
            "input": "search_semantic.topK",
            "output": "evidence.reranked",
            "multilingual": true,
            "variants": [
              {
                "id": "Qwen/Qwen3-Reranker-0.6B",
                "parameters": "0.6B",
                "contextLength": "32K"
              },
              {
                "id": "Qwen/Qwen3-Reranker-4B",
                "parameters": "4B",
                "contextLength": "32K"
              },
              {
                "id": "Qwen/Qwen3-Reranker-8B",
                "parameters": "8B",
                "contextLength": "32K"
              },
              {
                "id": "BAAI/bge-reranker-v2-m3",
                "parameters": "~0.57B"
              },
              {
                "id": "mixedbread-ai/mxbai-rerank-base-v2",
                "parameters": "base"
              }
            ],
            "selectionPolicy": "benchmark_then_route_by_resource_budget; do not infer fiqh authority from model score"
          },
          "watch": "Arabic and cross-lingual ranking quality, Quran/hadith evidence ordering, latency, max context, license changes"
        },
        {
          "id": "grounded_citation_engine",
          "name": "Verified RAG / Evidence Gate",
          "alternates": [
            "Ansari-style verification loop"
          ],
          "role": "Deterministic evidence gate: no approved evidence means NO_EVIDENCE.",
          "status": "candidate",
          "softwareLicense": "verify_per_component",
          "modelLicense": "not_applicable",
          "integration": {
            "position": "post_reranking_pre_generation",
            "failClosed": true,
            "canonicalCorpusWrite": false
          }
        },
        {
          "id": "quran_canonical_verification",
          "name": "Quran Canonical Text Verification",
          "alternates": [
            "Tanzil Quran Database",
            "official Quran source adapters"
          ],
          "role": "Canonical Quran retrieval and literal verification before display or speech.",
          "status": "candidate",
          "softwareLicense": "verify_per_component",
          "modelLicense": "not_applicable",
          "integration": {
            "position": "verification_layer",
            "failClosed": true,
            "canonicalCorpusWrite": false
          }
        },
        {
          "id": "arabic_diacritics_verification",
          "name": "Arabic Diacritics Verification",
          "alternates": [
            "Mishkal"
          ],
          "role": "Arabic orthographic and diacritics validation against canonical text.",
          "status": "candidate",
          "softwareLicense": "verify_per_component",
          "modelLicense": "not_applicable",
          "integration": {
            "position": "verification_layer",
            "failClosed": true,
            "canonicalCorpusWrite": false
          }
        },
        {
          "id": "hadith_verification_runtime",
          "name": "Hadith Verification Runtime",
          "alternates": [
            "Metadata-Driven Hadith Filter"
          ],
          "role": "Runtime provenance and grading gate separating source existence from authenticity.",
          "status": "candidate",
          "softwareLicense": "verify_per_component",
          "modelLicense": "not_applicable",
          "integration": {
            "position": "verification_layer",
            "failClosed": true,
            "canonicalCorpusWrite": false
          }
        },
        {
          "id": "sharia_policy_guardrails",
          "name": "Sharia Policy Guardrails",
          "alternates": [
            "Llama Guard",
            "NeMo Guardrails"
          ],
          "role": "Project-defined policy layer distinct from prompt-injection defense.",
          "status": "candidate",
          "softwareLicense": "verify_per_component",
          "modelLicense": "not_applicable",
          "integration": {
            "position": "verification_layer",
            "failClosed": true,
            "canonicalCorpusWrite": false
          }
        },
        {
          "id": "fiqh_knowledge_graph",
          "name": "Fiqh Knowledge Graph / Rule Tree",
          "alternates": [
            "Apache Jena",
            "Oxigraph",
            "Neo4j Community"
          ],
          "role": "Structured reviewed fiqh relations and deterministic rule dependencies.",
          "status": "candidate",
          "softwareLicense": "verify_per_component",
          "modelLicense": "not_applicable",
          "integration": {
            "position": "verification_layer",
            "failClosed": true,
            "canonicalCorpusWrite": false
          }
        },
        {
          "id": "agent_guardrail_firewall",
          "name": "LlamaFirewall",
          "alternates": [
            "Guardrails AI"
          ],
          "role": "Inspect user/system/tool messages for prompt-injection and related agent safety signals before privileged tool execution.",
          "status": "candidate",
          "softwareLicense": "MIT (LlamaFirewall component)",
          "modelLicense": "scanner-dependent; verify per scanner/model",
          "source": "https://github.com/meta-llama/PurpleLlama/tree/main/LlamaFirewall",
          "integration": {
            "position": "pre_tool_execution",
            "scopes": [
              "input",
              "system",
              "tool_call",
              "output"
            ],
            "failClosed": true
          },
          "watch": "scanner coverage, false positives, tool-call interception, dependency licenses, threat-model updates"
        },
        {
          "id": "vector_storage",
          "name": "Qdrant",
          "alternates": [
            "Milvus"
          ],
          "role": "Persist and index embeddings plus provenance/filter metadata for semantic and hybrid retrieval.",
          "status": "candidate",
          "softwareLicense": "Apache-2.0",
          "modelLicense": "not_applicable",
          "source": "https://github.com/qdrant/qdrant",
          "alternateLicense": {
            "Milvus": "Apache-2.0"
          },
          "integration": {
            "feedsFrom": [
              "embedding"
            ],
            "queriesFrom": [
              "search_semantic",
              "reranking"
            ],
            "metadataRequired": [
              "source",
              "document_id",
              "language",
              "rights_status",
              "sha256",
              "location"
            ],
            "selfHosted": true,
            "dockerSupported": true
          },
          "watch": "index size, Arabic recall, hybrid search, filtering, durability, resource cost"
        },
        {
          "id": "agent_orchestration",
          "name": "NVIDIA NeMo Guardrails",
          "alternates": [],
          "role": "Declarative orchestration and policy routing across specialized Rechercher Ω engines and tools.",
          "status": "candidate",
          "softwareLicense": "Apache-2.0",
          "modelLicense": "not_applicable",
          "source": "https://github.com/NVIDIA-NeMo/Guardrails",
          "integration": {
            "routes": {
              "image": "FLUX",
              "document_ocr": "PaddleOCR-VL",
              "speech_to_text": "whisper.cpp",
              "text_to_speech": "CosyVoice2-0.5B",
              "multimodal_reasoning": "Qwen3-Omni-30B-A3B-Instruct",
              "text_reasoning": "Qwen3-0.6B"
            },
            "policy": "route -> guard -> execute -> verify -> cite",
            "canonicalCorpusWrite": false
          },
          "watch": "rail compatibility, tool-calling behavior, policy evaluation, dependency health, Arabic intent routing"
        }
      ]
    }
  },
  "promotionPolicy": {
    "candidateToAdopted": [
      "all_required_license_fields_verified",
      "no_unknown_rights",
      "security_gate_passed",
      "Arabic_quality_benchmark_passed",
      "performance_benchmark_passed",
      "provenance_preserved",
      "human_review_recorded",
      "CI_passed"
    ],
    "automaticUpgrade": false,
    "silentReplacement": false,
    "canonicalCorpusMutation": false
  },
  "cadence": {
    "securityWatch": "daily",
    "releaseWatch": "weekly",
    "performanceBenchmark": "monthly",
    "qualityBenchmark": "monthly",
    "licenseReview": "on_change_and_quarterly"
  }
}
