    "audio_enhancement": {"primary":"deepfilternet","alternates":["rnnoise"],"status":"adopted","watch":"speech_intelligibility_noise_reduction_artifacts_realtime_latency","source":"https://github.com/Rikorose/DeepFilterNet"},
