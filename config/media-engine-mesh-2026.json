{
  "version": "2026-08-30",
  "purpose": "Discover, benchmark and coordinate open-source media engines as a single evidence-gated processing mesh for true high-resolution media.",
  "principle": "No application-imposed quality ceiling; no engine is enabled solely because it was discovered.",
  "pipeline": [
    "quarantine",
    "source-integrity",
    "rights-and-provenance",
    "metadata-capture",
    "restoration-selection",
    "spatial-super-resolution",
    "temporal-consistency",
    "optional-frame-interpolation",
    "color-hdr-preservation",
    "target-render",
    "objective-quality-evaluation",
    "artifact-lineage-and-checksum",
    "adaptive-delivery"
  ],
  "engineSelection": {
    "strategy": "capability-and-evidence-scoring",
    "neverChainBlindly": true,
    "benchmarkBeforePromotion": true,
    "compareSourceAndDerived": true,
    "preferNativeSource": true,
    "preserveAllIntermediatesNeededForAudit": true
  },
  "registeredEngines": [
    {"name":"Real-ESRGAN","family":"image-restoration-super-resolution","source":"https://github.com/xinntao/Real-ESRGAN"},
    {"name":"SwinIR","family":"image-restoration-super-resolution","source":"https://github.com/JingyunLiang/SwinIR"},
    {"name":"HAT","family":"image-super-resolution","source":"https://github.com/XPixelGroup/HAT"},
    {"name":"Video2X","family":"video-orchestration-upscaling","source":"https://github.com/K4YT3X/video2x"},
    {"name":"BasicVSR++","family":"video-super-resolution-temporal","source":"https://github.com/ckkelvinchan/BasicVSR_PlusPlus"},
    {"name":"SeedVR2","family":"video-restoration-diffusion","source":"https://github.com/IceClear/SeedVR2"},
    {"name":"FlashVSR","family":"streaming-video-super-resolution","source":"https://github.com/OpenImagingLab/FlashVSR"},
    {"name":"PS-SR","family":"video-super-resolution-speculative-diffusion","source":"https://github.com/HiDream-ai/PS-SR"},
    {"name":"AVSR-Diff","family":"arbitrary-scale-video-super-resolution","source":"https://github.com/KAIST-VICLab/AVSR-Diff"},
    {"name":"Real-CUGAN","family":"super-resolution","status":"candidate"},
    {"name":"RIFE","family":"frame-interpolation","source":"https://github.com/hzwer/ECCV2022-RIFE"},
    {"name":"Anime4K","family":"real-time-upscaling","status":"candidate"},
    {"name":"FFmpeg","family":"decode-encode-container","source":"https://ffmpeg.org/"}
  ],
  "futureDiscovery": {
    "enabled": true,
    "autoInstall": false,
    "autoEnable": false,
    "requiredEvidence": [
      "upstream-identity",
      "license-and-redistribution-review",
      "model-license-review",
      "reproducible-install",
      "runtime-detection",
      "hardware-and-vram-profile",
      "resolution-capability",
      "temporal-consistency-benchmark",
      "perceptual-and-fidelity-benchmark",
      "color-and-hdr-preservation-check",
      "checksum-and-lineage"
    ],
    "promotionStates":["discovered","audited","benchmarking","approved","enabled"],
    "unknownStateMeansDisabled":true
  },
  "nativeVsDerived": {
    "native": "captured/source geometry and characteristics verified",
    "derived": "generated or reconstructed by processing",
    "neverLabelDerivedAsNative":true
  },
  "targetQuality": {
    "masterResolution": null,
    "tiers":["24K","16K","12K","8K","4K"],
    "futureTiersAllowed":true,
    "tierAvailabilityDependsOnActualArtifact":true
  },
  "display": {
    "nanocell": {
      "enabledAsDisplayProfile": true,
      "processingRole": false,
      "preserveColorAndHdrMetadata": true,
      "true24KRequiresPhysicalDisplayValidation": true
    }
  },
  "freeFirst": {
    "paidApiRequired": false,
    "subscriptionRequired": false,
    "preferLocalOpenSourceTooling": true
  }
}
