{
  "engine": "Rechercher Learning Intelligence Engine v3",
  "version": "3.0.0",
  "status": "implemented-core",
  "purpose": "Graph-grounded learner intelligence with measurable diagnostics and source/evidence constraints.",
  "architecture": [
    "verified-corpus",
    "evidence-graph",
    "knowledge-graph",
    "prerequisite-graph",
    "misconception-graph",
    "learner-model",
    "diagnostic-engine",
    "method-selection",
    "practice",
    "evaluation",
    "learner-and-policy-update"
  ],
  "graphs": {
    "knowledge": {
      "enabled": true,
      "relationProvenanceRequired": true,
      "candidateRelationsAllowed": true
    },
    "evidence": {
      "enabled": true,
      "trace": [
        "learning-item",
        "concept",
        "claim",
        "evidence",
        "source",
        "edition",
        "page-or-passage",
        "rights",
        "review-state"
      ]
    },
    "prerequisite": {
      "enabled": true,
      "directional": true,
      "confidenceWeighted": true
    },
    "misconception": {
      "enabled": true,
      "hypothesisNotFact": true,
      "distinguishesFailureTypes": true
    },
    "learner": {
      "enabled": true,
      "dimensions": [
        "mastery",
        "retrieval",
        "explanation",
        "application",
        "discrimination",
        "transfer",
        "source-navigation",
        "retention",
        "confidence-calibration"
      ]
    }
  },
  "calibration": {
    "correctnessSeparateFromConfidence": true,
    "tracksBias": true,
    "tracksHistoryByContext": true
  },
  "multimodal": {
    "profile": [
      "text",
      "audio",
      "visual",
      "speech",
      "source-navigation"
    ],
    "privacyFirst": true,
    "biometricInference": false,
    "speechOptIn": true
  },
  "methodRegistry": {
    "versioned": true,
    "feedbackRequirements": true,
    "targetSkills": true,
    "prerequisites": true,
    "stages": true
  },
  "evaluation": {
    "immediate": true,
    "delayed": true,
    "transfer": true,
    "ablation": true,
    "minimumTrialsBeforeComparison": 10,
    "noUniversalBestClaim": true,
    "noAutomaticPromotion": true
  },
  "llmRole": [
    "explanation",
    "generation",
    "dialogue",
    "candidate-relation-discovery",
    "adaptive-assistance"
  ],
  "llmConstraints": {
    "mustCiteEvidence": true,
    "generatedOutputIsCanonical": false,
    "unsupportedFactsRejected": true
  },
  "religiousSafeguards": {
    "canonicalQuranArabicUnchanged": true,
    "preserveScholarlyDisagreement": true,
    "unknownRightsDoNotGrantDownload": true,
    "sensitiveClaimsHumanReview": true
  },
  "acquisitionBoundary": {
    "learningMayNotBlockPdfAcquisition": true,
    "graphFailureMayNotBlockPdfAcquisition": true,
    "evaluationFailureMayNotBlockPdfAcquisition": true,
    "multimodalFailureMayNotBlockPdfAcquisition": true
  }
}
