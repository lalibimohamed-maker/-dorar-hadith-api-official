{
  "schema_version": "1.0.0",
  "purpose": "Technical license and terms gate for Omega video engines.",
  "public_redistribution_never_auto_enabled": true,
  "corpus_write_allowed": false,
  "engines": {
    "hunyuanvideo-1.5": {
      "license_source": "Tencent Hunyuan Community License Agreement",
      "license_url": "https://github.com/Tencent-Hunyuan/HunyuanVideo-1.5/blob/main/LICENSE",
      "territory": "worldwide except European Union, United Kingdom and South Korea",
      "public_service_requires_terms_and_disclosures": true,
      "large_service_threshold_requires_separate_license": true,
      "cross_model_improvement_restricted": true
    },
    "ltx-2": {
      "license_source": "LTX-2 Community License Agreement",
      "license_url": "https://github.com/Lightricks/LTX-2/blob/main/LICENSE-2",
      "worldwide_subject_to_restrictions": true,
      "commercial_entity_threshold_usd": 10000000,
      "public_distribution_requires_terms_and_notices": true
    }
  },
  "activation": {
    "local_use_status": "review_required_under_upstream_terms",
    "redistribution_status": "review_required",
    "operator_terms_check_required": true,
    "deployment_territory_check_required_for_hunyuan": true
  }
}
