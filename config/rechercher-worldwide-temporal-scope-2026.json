{
  "engine": "rechercher-worldwide-temporal-scope",
  "version": "1.0.0",
  "scope": "WORLDWIDE_AND_ALL_ERAS",
  "temporal_range": {"start": "PROPHETIC_ERA", "end": "PRESENT_AND_FUTURE", "open_ended": true},
  "rule": "Never reduce the research corpus to a single century, dynasty, school, language, region, or historical period unless the user explicitly scopes a query.",
  "historical_layers": ["PROPHETIC_ERA","COMPANIONS","SUCCESSORS","EARLY_CLASSICAL","CLASSICAL","POST_CLASSICAL","MODERN","CONTEMPORARY","FUTURE"],
  "future_works": {"catalogue_as_discovered": true,"identity_required": true,"provenance_required": true,"rights_required_for_publication": true},
  "search_behavior": {"default_global": true,"date_filter_optional": true,"century_filter_optional": true,"negative_evidence_tracked": true}
}