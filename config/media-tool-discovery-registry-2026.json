{
  "version": "2026-08-27",
  "purpose": "Continuously discover newer media, processing, storage and interoperability tooling without silently installing or trusting arbitrary software.",
  "policy": {
    "discoverAutomatically": true,
    "installAutomatically": false,
    "promoteAutomatically": false,
    "requirePinnedEvidence": true,
    "requireLicenseCheck": true,
    "requireSecurityValidation": true,
    "requireProtectedPRForUpdates": true,
    "unknownProjectIsUntrusted": true
  },
  "capabilities": [
    {
      "id": "image-super-resolution",
      "preferredProject": "xinntao/Real-ESRGAN",
      "upstream": "https://github.com/xinntao/Real-ESRGAN",
      "selectionCriteria": ["quality", "tiling", "scale-flexibility", "active-maintenance", "license"]
    },
    {
      "id": "video-upscaling",
      "preferredProject": "Waifu2x-Extension-Team/waifu2x-Extension-GUI",
      "upstream": "https://github.com/AaronFeng753/Waifu2x-Extension-GUI",
      "selectionCriteria": ["video-upscaling", "frame-interpolation", "codec-support", "active-maintenance", "license"]
    },
    {
      "id": "media-transcoding",
      "preferredProject": "FFmpeg/FFmpeg",
      "upstream": "https://github.com/FFmpeg/FFmpeg",
      "selectionCriteria": ["codec-coverage", "performance", "maintainability", "license"]
    },
    {
      "id": "ocr-document-processing",
      "preferredProject": "tesseract-ocr/tesseract",
      "upstream": "https://github.com/tesseract-ocr/tesseract",
      "selectionCriteria": ["ocr-quality", "language-coverage", "maintainability", "license"]
    },
    {
      "id": "backup-integrity",
      "preferredProjects": ["restic/restic", "borgbackup/borg"],
      "upstreams": ["https://github.com/restic/restic", "https://github.com/borgbackup/borg"],
      "selectionCriteria": ["integrity", "encryption", "restore-verification", "maintainability", "license"]
    },
    {
      "id": "runtime-observability",
      "preferredProjects": ["wazuh/wazuh", "falcosecurity/falco"],
      "upstreams": ["https://github.com/wazuh/wazuh", "https://github.com/falcosecurity/falco"],
      "selectionCriteria": ["runtime-detection", "file-integrity", "maintainability", "license"]
    },
    {
      "id": "live-media-routing",
      "preferredProject": "bluenviron/mediamtx",
      "upstream": "https://github.com/bluenviron/mediamtx",
      "selectionCriteria": ["WebRTC", "HLS", "RTSP", "SRT", "RTMP", "maintainability", "license"]
    }
  ],
  "discoverySources": [
    "https://api.github.com/repos/{owner}/{repo}/releases/latest",
    "https://api.github.com/repos/{owner}/{repo}/tags?per_page=10"
  ],
  "prohibitedAutoActions": [
    "download-and-execute-unknown-binary",
    "install-unreviewed-system",
    "replace-trusted-content",
    "change-main-without-protected-pr",
    "change-corpus-without-provenance-rights-verification"
  ]
}
