{
  "schema_version": "1.0.0",
  "purpose": "Free-first runtimes for executing Rechercher Omega media jobs.",
  "policy": {
    "prefer_local": true,
    "paid_fallback_allowed": false,
    "corpus_write_allowed": false,
    "generated_media_is_evidence": false
  },
  "runtimes": [
    {
      "id": "local-comfyui",
      "kind": "local",
      "engine": "comfyui",
      "free": true,
      "requires_gpu": true,
      "endpoint_env": "COMFYUI_URL",
      "capabilities": [
        "text_to_image",
        "image_editing",
        "text_to_video",
        "image_to_video",
        "video_to_video"
      ],
      "priority": 10
    },
    {
      "id": "local-ffmpeg",
      "kind": "local",
      "engine": "ffmpeg",
      "free": true,
      "requires_gpu": false,
      "capabilities": [
        "video_composition",
        "audio_mix",
        "subtitle_burn",
        "transcode"
      ],
      "priority": 20
    },
    {
      "id": "kaggle-gpu",
      "kind": "remote_gpu",
      "engine": "kaggle",
      "free": true,
      "requires_gpu": true,
      "capabilities": [
        "model_inference",
        "video_generation",
        "image_generation",
        "audio_generation",
        "ocr"
      ],
      "priority": 30
    },
    {
      "id": "huggingface-inference",
      "kind": "remote_api",
      "engine": "huggingface",
      "free": true,
      "requires_gpu": false,
      "requires_api_key": true,
      "capabilities": [
        "model_inference"
      ],
      "priority": 40
    },
    {
      "id": "local-comfyui-pinned",
      "kind": "local",
      "engine": "comfyui",
      "free": true,
      "requires_gpu": true,
      "version": "0.37.0",
      "runtime_release": "dinullah-omega-ai-media-runtime-v2026.09.29",
      "capabilities": [
        "text_to_image",
        "image_editing",
        "text_to_video",
        "image_to_video",
        "video_to_video",
        "audio_generation",
        "3d"
      ],
      "priority": 5
    },
    {
      "id": "local-omega-ai-runtime",
      "kind": "local",
      "engine": "python-ai-stack",
      "free": true,
      "requires_gpu": true,
      "version_set": "torch==2.14.0; transformers==5.17.0; diffusers==0.40.0; accelerate==1.15.0; safetensors==0.8.0",
      "runtime_release": "dinullah-omega-ai-media-runtime-v2026.09.29",
      "capabilities": [
        "model_inference",
        "multimodal_inference",
        "diffusion_generation",
        "video_generation",
        "image_generation"
      ],
      "priority": 8
    }
  ]
}
