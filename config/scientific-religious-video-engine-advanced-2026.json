    "video_super_resolution": [
      {"name":"BasicVSR++","status":"candidate","softwareLicense":"Apache-2.0","role":"video_super_resolution_and_temporal_propagation","weights":"verify_checkpoint_terms","source":"https://github.com/c-ck/BasicVSR_PlusPlus"},
      {"name":"RealBasicVSR","status":"candidate","softwareLicense":"verify_current_repository_terms","role":"real_world_video_super_resolution_restoration","weights":"verify_checkpoint_terms","source":"https://github.com/c-ck/RealBasicVSR"},
      {"name":"Video2X","status":"license_gated","softwareLicense":"AGPL-3.0","role":"video_upscaling_orchestration","weights":"verify_each_backend","source":"https://github.com/k4yt3x/video2x"},
