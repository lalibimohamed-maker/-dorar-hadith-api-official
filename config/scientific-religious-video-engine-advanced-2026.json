{
  "schemaVersion": "1.0.0",
  "purpose": "Advanced registry for original scientific-religious video creation, evidence-driven composition, lawful media synthesis, and high-fidelity rendering up to 48K-class masters.",
  "status": "candidate_benchmark_only",
  "principles": {
    "originalCreationPreferred": true,
    "licensedMediaOnly": true,
    "referenceOnlyMediaIsNotEmbeddable": true,
    "scientificClaimsRequireSources": true,
    "religiousClaimsRequireVerification": true,
    "quranTextMustRemainVerbatim": true,
    "translationIsDistinctFromArabicText": true,
    "voiceRightsRequired": true,
    "provenancePerAsset": true,
    "noRuntimePromotion": true,
    "noCorpusMutation": true,
    "noSilentReplacement": true,
    "noArtificialResolutionCeiling": true
  },
  "creationArchitecture": [
    "question_understanding",
    "subquestion_and_claim_extraction",
    "islamic_evidence_retrieval",
    "scientific_evidence_retrieval",
    "claim_verification",
    "evidence_graph",
    "source_and_rights_resolution",
    "global_media_discovery",
    "original_scene_generation",
    "scientific_simulation_or_explanatory_graphics",
    "semantic_scene_composition",
    "scene_analysis",
    "quran_text_layer",
    "hadith_layer_and_grading",
    "quran_word_alignment",
    "multilingual_meanings_translation",
    "voice_and_audio_rights",
    "timeline_composition",
    "documentary_direction",
    "accessibility",
    "quality_control",
    "provenance_manifest",
    "multi_stage_render",
    "mastering_and_delivery"
  ],
  "technicalCandidates": {
    "video_generation": [
      {"name":"Wan2.1","status":"candidate","softwareLicense":"Apache-2.0","modelRights":"verify_dataset_and_weight_terms","source":"https://github.com/Wan-Video/Wan2.1"},
      {"name":"LTX-2.x","status":"license_gated","softwareLicense":"LTX-2.x Community License","modelRights":"commercial_and_attachment_terms_must_be_verified","source":"https://github.com/Lightricks/LTX-2"},
      {"name":"HunyuanVideo","status":"license_gated","softwareLicense":"Tencent Hunyuan Community License","modelRights":"territory_and_use_terms_must_be_verified","source":"https://github.com/Tencent-Hunyuan/HunyuanVideo"},
      {"name":"CogVideoX","status":"candidate","softwareLicense":"Apache-2.0 for selected components; model-specific terms vary","modelRights":"verify_per_model_variant","source":"https://github.com/THUDM/CogVideo"}
    ],
    "timeline_and_editing": [
      {"name":"OpenTimelineIO","status":"candidate","softwareLicense":"Apache-2.0","role":"deterministic editorial timeline interchange","source":"https://github.com/AcademySoftwareFoundation/OpenTimelineIO"},
      {"name":"FFmpeg","status":"candidate","softwareLicense":"LGPL/GPL depending on build and enabled components","role":"decode_transform_encode_mastering","rightsGate":"record_exact_build_configuration","source":"https://ffmpeg.org/"}
