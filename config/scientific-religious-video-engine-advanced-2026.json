  "mastering": {
    "resolutionPolicy": {
      "720p": "1280x720",
      "1080p": "1920x1080",
      "1440p": "2560x1440",
      "4K": "3840x2160",
      "8K": "7680x4320",
      "16K": "15360x8640",
      "32K": "30720x17280",
      "48K": "46080x25920",
      "48KPortrait": "25920x46080",
      "futureExpansion": "architecture remains open to higher-than-48K masters"
    },
    "renderPipeline": [
      "source_validation",
      "scene_generation_or_cleared_media_ingest",
      "denoise_deblur",
      "temporal_consistency",
      "video_super_resolution",
      "detail_recovery",
      "text_and_diagram_vector_overlay_at_target_resolution",
      "artifact_detection",
      "frame_consistency_check",
      "final_48k_master_render",
      "delivery_downscale_variants"
    ],
    "qualityRules": {
      "neverTreatUpscaleAsNewInformation": true,
      "preserveScientificLabels": true,
      "preserveQuranText": true,
      "preserveHadithText": true,
      "preserveCitations": true,
      "preferVectorTextOverUpscaledText": true,
      "masterMayExceedGenerationResolution": true,
      "nativeGenerationAt48KNotRequired": true
    }
  },
  "rightsPolicy": {
    "allowedMediaClasses": ["public_domain","compatible_open_license","explicit_permission","original_generated"],
    "referenceOnlyClass": "reference_only_not_embeddable",
    "requiredManifestFields": ["assetId","sourceUrl","creator","license","licenseEvidence","retrievedAt","sha256","usageScope","attribution","modelOrTool","modelVersion"],
    "voice": "No voice cloning or synthetic identity imitation without explicit rights; a licensed original recording may be aligned word-by-word."
  },
  "promotion": {
    "productionUseRequires": ["rights_verified","evidence_verified","security_passed","arabic_quality_benchmark","visual_quality_benchmark","performance_benchmark","provenance_complete","human_review","CI_passed"],
    "automaticPromotion": false
  }
}
