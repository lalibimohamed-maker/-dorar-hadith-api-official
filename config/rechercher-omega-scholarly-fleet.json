  "rights_profile": {
    "default": "review_required",
    "allowed_states": [
      "verified_public_domain",
      "verified_license",
      "source_permission",
      "link_only",
      "review_required",
      "blocked"
    ],
    "promotion_rule": "Only verified_public_domain, verified_license, or explicit source_permission may be promoted to public downloadable media, subject to item-level terms."
  },
  "provenance_profile": {
    "required": [
      "source_id",
      "family_id",
      "source_locator",
      "retrieved_at",
      "rights_status"
    ],
    "recommended": [
      "source_revision",
      "etag",
      "content_type",
      "content_length",
      "sha256",
      "edition_id",
      "author_id",
      "work_id",
      "language"
    ],
    "immutable_after_ingest": [
      "source_id",
      "source_locator",
      "retrieved_at",
      "sha256"
    ]
  },
  "adapter_profile": {
    "allowed_kinds": [
      "official_api",
      "official_institutional",
      "metadata_api",
      "web_source",
      "digital_library",
      "library_catalog",
      "national_library",
      "scholarly_corpus",
      "bibliographic_service",
      "library_discovery"
    ],
    "execution_rule": "Adapters fetch only the declared source; they cannot rewrite canonical text, decide rights, or write to Corpus."
  },
  "expansion": {
    "target_domain_cells": 24,
    "current_family_count": 24,
    "rule": "Add new families or source connectors without changing the shared contract or moving scientific content into the system layer.",
    "future_candidates": [],
    "future_expansion_types": [
      "additional_sources_per_family",
      "new_country_registries",
      "additional_official_apis",
      "new_library_connectors",
      "new_metadata_crosswalks"
    ]
  },
  "references": {
    "quran_foundation_docs": "https://api-docs.quran.com/",
    "quran_foundation_manual_auth": "https://api-docs.quran.com/docs/quickstart/manual-authentication/",
    "sunnah_api_repository": "https://github.com/sunnah-com/api",
    "sunnah_api_docs": "https://sunnah.stoplight.io/docs/api/",
    "openiti_docs": "https://openiti.org/documentation/",
    "openiti_corpus": "https://openiti.org/projects/OpenITI%20Corpus.html"
  },
