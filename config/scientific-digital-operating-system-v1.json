{
  "schema":"din-allah-encyclopedia/operating-system/v1",
  "version":"1.0.0","build":"2026",
  "principle":"DISCOVERY != IDENTITY != EDITION != DIGITAL_COPY != RIGHTS != PUBLICATION",
  "pipeline":["DISCOVERED","IDENTIFIED","EDITION_RESOLVED","SOURCE_VERIFIED","RIGHTS_VERIFIED","ACQUIRED","SHA256_LOCKED","PDF_VALIDATED","PAGE_INTEGRITY_PASSED","OCR","OCR_CONFIDENCE_REVIEW","TEXT_COLLATION","TEXT_VERIFIED","QUALITY_SCORED","PUBLICATION_APPROVED"],
  "holdPolicy":"missing-or-failed-stage=HOLD; automatic-skipping=false",
  "identity":["WORK_ID","EDITION_ID","DIGITAL_COPY_ID","SOURCE_ID","RIGHTS_EVIDENCE_ID"],
  "rightsRequired":["rights_source","rights_evidence","rights_checked_at","rights_checked_by","license","territory","expiry","redistribution_allowed","derivative_allowed"],
  "quality":{"weights":{"Identity":20,"Source":20,"Scan":15,"Completeness":15,"OCR":15,"Metadata":10,"Rights":5},"publicationMinimum":80},
  "pageIntegrity":["page_count","missing_pages","duplicate_pages","blank_pages","orientation_anomalies","corrupt_pages","volume_completeness"],
  "ocr":{"derivedOnly":true,"requiredPerPage":["image_sha256","sidecar_text","engine","engine_version","language","confidence"],"humanReviewBelow":0.9,"publicationConfidenceMinimum":0.97,"authoritative":false},
  "collation":{"required":["ocr_vs_page_image","edition_differences","unresolved_differences"],"unresolvedBlocksTextVerification":true},
  "deltaDetection":{"fields":["source","edition","rights","sha256","page_count","ocr_quality"],"automaticReacquisition":false},
  "monitoring":["latency","success_rate","candidate_rate","acquisition_rate","validation_failures","rights_holds","low_confidence_ocr_pages","collation_conflicts","publication_rejections","backup_last_success","recovery_last_test"],
  "backup":{"minimumEncryptedCopies":2,"separatedCopy":true,"restoreTestRequired":true,"rpoHours":24,"rtoHours":24},
  "audit":["who","what","when","source","old_value","new_value","reason","commit","hash"],
  "publication":{"minimumQualityScore":80,"requiresAudit":true,"requiresRights":true,"requiresPageIntegrity":true,"requiresTextVerification":true}
}