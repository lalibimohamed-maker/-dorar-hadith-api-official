{
  "engine": "Rechercher Learning Intelligence Engine v4",
  "version": "4.0.0",
  "status": "implemented-core",
  "memory": {
    "session": {
      "ephemeral": true,
      "rawMicroEventsAllowed": true,
      "maxRecentSignals": 50
    },
    "longTerm": {
      "summaryOnly": true,
      "rawEventLogDefault": false,
      "stores": [
        "mastery",
        "calibration",
        "misconceptions",
        "modality_profile",
        "transfer_history"
      ]
    }
  },
  "feedbackLoopBuffer": {
    "signals": [
      "pause",
      "hesitation",
      "revision",
      "hint_request",
      "answer_attempt",
      "confidence_change",
      "navigation",
      "completion"
    ],
    "maxSessionEvents": 50,
    "rawDiaryPersisted": false,
    "feeds": [
      "diagnosis",
      "calibration",
      "method_selection"
    ]
  },
  "crossDomainTransfer": {
    "enabled": true,
    "requiredFields": [
      "sourceSkillId",
      "targetSkillId",
      "relation",
      "evidence",
      "confidence",
      "provenance"
    ],
    "evaluationSeparateFromSourceMastery": true
  },
  "pedagogicalSafety": {
    "scaffoldBeforeAnswer": true,
    "preserveStruggle": true,
    "noAnswerDump": true,
    "progressiveDisclosure": true,
    "learnerAgency": true,
    "sourceGrounded": true,
    "rightsAware": true,
    "noBiometricInferenceByDefault": true,
    "religiousDirectAnswerRequires": {
      "sourceId": true,
      "sourceAnchorOrPageOrLocation": true,
      "sourceGroundedExplicit": true
    }
  },
  "acquisitionBoundary": {
    "learningDownstream": true,
    "learningFailureNonBlocking": true,
    "graphFailureNonBlocking": true,
    "evaluationFailureNonBlocking": true,
    "multimodalFailureNonBlocking": true
  }
}
