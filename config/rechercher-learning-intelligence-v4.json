{
  "engine":"Rechercher Learning Intelligence Engine v4",
  "version":"4.0.0",
  "status":"implemented",
  "purpose":"Session-aware, long-term, evidence-grounded adaptive learning with explicit transfer and pedagogical safety",
  "memory":{
    "session":true,
    "longTerm":true,
    "sessionSummaryBeforeDurablePersistence":true,
    "rawSessionEventsDurablyPersistedByDefault":false,
    "rawFeedbackDurablyPersistedByDefault":false,
    "boundedFeedbackBuffer":true,
    "defaultFeedbackBufferLimit":32
  },
  "transfer":{
    "explicitRoutes":true,
    "requiresSourceAndTargetSkills":true,
    "requiresProvenanceBackedEvidence":true,
    "statuses":["candidate","evidence_supported","needs_review","completed"]
  },
  "adaptive":{
    "modalitySelection":true,
    "scaffolding":true,
    "sequenceSelection":true,
    "practiceSelection":true,
    "retrievalPreservation":true,
    "directAnswerMayBeConstrained":true
  },
  "pedagogicalSafety":{
    "sourceGrounded":true,
    "uncertaintyExplicit":true,
    "generatedClaimsAreNotEvidence":true,
    "humanReviewRoute":true,
    "autonomousReligiousAuthority":false
  },
  "authority":{
    "verifiedCorpus":true,
    "provenance":true,
    "rights":true,
    "scholarlyEvidence":true
  },
  "acquisitionBoundary":{
    "learningCannotBlockPdfAcquisition":true,
    "learningFailureIsNonBlocking":true
  }
}