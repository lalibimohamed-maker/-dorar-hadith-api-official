{
  "schemaVersion": "1.0.0",
  "purpose": "Unified settings governance for Deen Allah Encyclopedia across privacy, security, accessibility, localization, performance, content, media, search, downloads, accounts, and recovery.",
  "principles": {
    "secureByDefault": true,
    "privacyByDefault": true,
    "leastPrivilege": true,
    "dataMinimization": true,
    "offlineFirst": true,
    "explicitConsent": true,
    "reversibleSettings": true,
    "noDarkPatterns": true,
    "originalContentImmutable": true,
    "rightsFailClosed": true
  },
  "domains": {
    "privacy": {
      "telemetry": "off_by_default",
      "personalization": "local_first",
      "searchHistory": "local_and_user_deletable",
      "voiceData": "local_first_and_ephemeral_when_possible",
      "keyboardData": "never_upload_keystrokes_without_explicit_consent",
      "clearData": true,
      "exportData": true
    },
    "security": {
      "sessionTimeout": true,
      "deviceLockIntegration": true,
      "trustedSourcesOnly": true,
      "safeDownloads": true,
      "malwareScan": true,
      "contentIntegrityVerification": true,
      "securityNotifications": true,
      "unsafeFeatureWarning": true
    },
    "content": {
      "sourceProvenanceVisible": true,
      "rightsStatusVisible": true,
      "editionVisible": true,
      "publicationDateVisible": true,
      "verificationStateVisible": true,
      "scientificClaimEvidenceVisible": true,
      "miracleClaimReviewStateVisible": true,
      "noSilentSubstitution": true
    },
    "search": {
      "arabicNormalization": "search_only",
      "diacriticsToggle": true,
      "exactMatch": true,
      "semanticSearch": true,
      "filters": true,
      "sourceFilter": true,
      "schoolFilter": true,
      "bookFilter": true,
      "dateFilter": true,
      "searchHistoryClear": true
    },
    "keyboardAndInput": {
      "engineSelection": true,
      "layoutSelection": true,
      "languageSelection": true,
      "suggestions": true,
      "autocorrection": true,
      "diacriticsToolbar": true,
      "quranicSymbols": true,
      "voiceInput": true,
      "physicalKeyboard": true,
      "keyboardPrivacyIndicator": true
    },
    "languageAndAccessibility": {
      "rtl": true,
      "ltr": true,
      "fontSize": true,
      "lineSpacing": true,
      "contrast": true,
      "reducedMotion": true,
      "screenReader": true,
      "keyboardNavigation": true,
      "captions": true,
      "textToSpeech": true,
      "voiceSelection": true
    },
    "appearance": {
      "theme": true,
      "lightDarkSystem": true,
      "accent": true,
      "background": true,
      "animationDuration": true,
      "motionIntensity": true,
      "previewBeforePublish": true
    },
    "media": {
      "imageQuality": true,
      "8kEnhancement": true,
      "audioQuality": true,
      "noiseReduction": true,
      "downloadFormat": true,
      "bandwidthMode": true,
      "dataSaver": true,
      "hardwareAcceleration": true
    },
    "downloads": {
      "wifiOnly": true,
      "parallelDownloads": true,
      "resume": true,
      "destination": true,
      "integrityVerification": true,
      "rightsGate": true,
      "downloadHistory": true,
      "autoDelete": true
    },
    "performance": {
      "cacheControl": true,
      "offlineStorageQuota": true,
      "backgroundSync": true,
      "lowMemoryMode": true,
      "reducedDataMode": true,
      "performanceDiagnostics": true
    },
    "accountsAndGovernance": {
      "accountLinking": "explicit_only",
      "roleBasedAccess": true,
      "auditLog": true,
      "sessionRevoke": true,
      "twoFactorRecommended": true,
      "dangerousActionsRequireConfirmation": true,
      "settingsImportExport": true,
      "resetToSafeDefaults": true
    },
    "backupAndRecovery": {
      "configurationBackup": true,
      "encryptedBackup": true,
      "restoreTest": true,
      "recoveryVerification": true,
      "corpusProtection": true
    }
  },
  "dangerousActions": [
    "delete_library",
    "clear_all_local_data",
    "disable_security_controls",
    "publish_unverified_source",
    "change_authoritative_source",
    "overwrite_original_text",
    "disable_rights_gate"
  ],
  "defaultRule": "When a setting can affect privacy, rights, provenance, security, or authoritative content, choose the safer reversible default and require explicit confirmation for escalation."
}
