{
  "schemaVersion": "1.0.0",
  "runtimeId": "dinullah-open-media-runtime-2026",
  "purpose": "Reproducible free-first runtime definition for the complete open interoperability/media toolchain.",
  "activation": {
    "reproducible": true,
    "noPaidSaaSDependency": true,
    "noUnknownBinaryExecution": true,
    "sourceAndLicenseEvidenceRequired": true,
    "runtimeVerificationRequired": true,
    "releaseWeightsOnly": true
  },
  "software": [
    {
      "id": "nifi",
      "project": "apache/nifi",
      "version": "2.12.0",
      "mode": "container",
      "image": "apache/nifi:2.12.0",
      "role": "dataflow/provenance"
    },
    {
      "id": "ditto",
      "project": "eclipse-ditto/ditto",
      "version": "3.9.7",
      "mode": "official-compose",
      "role": "digital-twin/policy-connectivity",
      "requires": [
        "mongodb>=4.2"
      ]
    },
    {
      "id": "nats",
      "project": "nats-io/nats-server",
      "version": "2.15.0",
      "mode": "container",
      "image": "nats:2.15.0",
      "role": "messaging"
    },
    {
      "id": "openusd",
      "project": "PixarAnimationStudios/OpenUSD",
      "version": "26.8",
      "mode": "python-package",
      "role": "3d-scene-interchange",
      "package": "usd-core==26.8",
      "licenseNote": "PyPI package currently lists LicenseRef-TOST-1.0; full OpenUSD distribution/code licensing must be reviewed separately."
    },
    {
      "id": "gltf",
      "project": "KhronosGroup/glTF",
      "version": "2.0-specification",
      "mode": "format-standard",
      "role": "web-3d-interchange",
      "runtimeBinary": false,
      "install": "format-standard-no-install"
    },
    {
      "id": "gltf-validator",
      "project": "KhronosGroup/glTF-Validator",
      "version": "2.0.0-dev.3.10",
      "mode": "npm/package",
      "role": "gltf-validation"
    },
    {
      "id": "real-esrgan",
      "project": "xinntao/Real-ESRGAN",
      "version": "0.3.0",
      "mode": "python-package/source",
      "role": "image-restoration"
    },
    {
      "id": "video2x",
      "project": "K4YT3X/video2x",
      "version": "6.4.0",
      "mode": "container",
      "role": "video-upscaling/frame-interpolation",
      "requires": [
        "Vulkan"
      ],
      "image": "ghcr.io/k4yt3x/video2x:6.4.0",
      "license": "AGPL-3.0",
      "provenance": "official Video2X 6.4.0 release/image; immutable release asset SHA-256 is recorded when cached",
      "releaseAsset": "Video2X-x86_64.AppImage"
    },
    {
      "id": "ffmpeg",
      "project": "FFmpeg/FFmpeg",
      "version": "package-pinned-build",
      "mode": "host-package",
      "role": "decode/encode/transcode"
    },
    {
      "id": "tesseract",
      "project": "tesseract-ocr/tesseract",
      "version": "package-pinned-build",
      "mode": "host-package",
      "role": "ocr"
    },
    {
      "id": "paddleocr",
      "project": "PaddlePaddle/PaddleOCR",
      "version": "3.7.0",
      "mode": "python-package",
      "role": "modern-document-ocr",
      "requires": [
        "PaddlePaddle>=3.0"
      ]
    },
    {
      "id": "colmap",
      "project": "colmap/colmap",
      "version": "4.2.0",
      "mode": "docker-or-conda",
      "role": "multi-view-3d-reconstruction",
      "install": "conda-forge::colmap=4.2.0 or official CUDA Docker build",
      "provenance": "prefer official release/attested PyPI pycolmap 4.2.0 when Python API is sufficient"
    },
    {
      "id": "open3d",
      "project": "isl-org/Open3D",
      "version": "0.20.0",
      "mode": "python-package",
      "role": "3d-data-geometry-visualization"
    },
    {
      "id": "mediamtx",
      "project": "bluenviron/mediamtx",
      "version": "1.21.1",
      "mode": "container",
      "image": "bluenviron/mediamtx:1.21.1",
      "role": "live-media-routing"
    },
    {
      "id": "paddlepaddle",
      "project": "PaddlePaddle/Paddle",
      "version": "3.2.0",
      "mode": "python-package-or-container",
      "role": "PaddleOCR inference backend",
      "requiredBy": [
        "paddleocr"
      ]
    },
    {
      "id": "ditto-mongodb",
      "project": "MongoDB",
      "version": "8.0",
      "mode": "container",
      "role": "Eclipse Ditto backing datastore",
      "requiredBy": [
        "ditto"
      ]
    },
    {
      "id": "vmaf",
      "project": "Netflix/vmaf",
      "version": "3.x-line",
      "mode": "source-or-package",
      "role": "perceptual-video-quality-assessment",
      "license": "BSD+Patent",
      "source": "https://github.com/Netflix/vmaf"
    },
    {
      "id": "pyscenedetect",
      "project": "Breakthrough/PySceneDetect",
      "version": "0.7.1",
      "mode": "python-package-or-container",
      "role": "scene-shot-detection-and-segmentation",
      "source": "https://github.com/Breakthrough/PySceneDetect"
    }
  ],
  "python": {
    "version": "3.12",
    "packages": {
      "paddleocr": "3.7.0",
      "paddlepaddle": "3.2.0",
      "open3d": "0.20.0",
      "pycolmap": "4.2.0",
      "realesrgan": "0.3.0"
    }
  },
  "weightsRelease": {
    "tag": "dinullah-media-weights-v2026.09.29",
    "repository": "lalibimohamed-maker/-dorar-hadith-api-official",
    "manifest": "config/media-weight-release-manifest-2026.json",
    "sourceOfTruth": "github-release-assets",
    "models": [
      "Real-ESRGAN",
      "Video2X RIFE",
      "PaddleOCR Arabic"
    ],
    "noWeightsInGit": true
  },
  "services": {
    "nifi": {
      "health": "https://localhost:8443/nifi/"
    },
    "nats": {
      "clientPort": 4222,
      "monitorPort": 8222
    },
    "mediamtx": {
      "apiOrControlPorts": [
        8554,
        8888,
        8889
      ]
    },
    "ditto": {
      "entrypoint": "http://localhost:8080"
    }
  },
  "verification": [
    "binary-or-package-version check",
    "container health check",
    "python import/version check",
    "gltf-validator smoke test",
    "video2x --help with Vulkan capability probe",
    "source/weight SHA-256 manifest",
    "security scan before promotion",
    "no trusted-source overwrite",
    "studio release asset and license manifest check",
    "Omega media bridge contract check",
    "MLT/Frei0r effect backend check",
    "MediaInfo metadata probe",
    "PipeWire audio graph probe",
    "Subtitle Composer installation/source check",
    "Flamenco render-manager package check",
    "Natron compositing package check",
    "OpenImageIO import/version check",
    "conversation runtime manifest/Release check",
    "MADLAD/OPUS/Habibi weight lock check",
    "Pipecat/WebRTC voice pipeline smoke check",
    "lip-sync pipeline dependency/license check",
    "VMAF/PSNR/SSIM derived-output quality probe",
    "PySceneDetect scene/shot segmentation smoke test",
    "resource admission and GPU-concurrency policy check",
    "semantic cache invalidation check",
    "public publication readiness gate check"
  ],
  "notes": [
    "NiFi 2.12.0 is the current upstream release as of 2026-09-29.",
    "Eclipse Ditto 3.9.7 is the current upstream release and requires its official multi-service deployment plus MongoDB.",
    "NATS 2.15.0, OpenUSD 26.08, COLMAP 4.2.0 and Open3D 0.20.0 are current pinned choices based on official release evidence.",
    "glTF is an interchange specification rather than a standalone runtime service; glTF-Validator is the executable validation layer.",
    "Video2X requires Vulkan-capable hardware for actual acceleration; binary presence alone is not a performance proof.",
    "Model weights are release assets and are never silently downloaded from discovery."
  ],
  "studioToolchain": {
    "manifest": "config/media-studio-toolchain-2026.json",
    "releaseTag": "dinullah-media-studio-v2026.09.29",
    "activation": "desktop-production-layer",
    "tools": [
      "kdenlive",
      "blender",
      "obs",
      "ardour",
      "audacity",
      "gimp",
      "inkscape",
      "glaxnimate",
      "imagemagick",
      "opentimelineio",
      "opencolorio",
      "mlt",
      "frei0r",
      "mediainfo",
      "subtitlecomposer",
      "pipewire",
      "openimageio",
      "natron",
      "flamenco",
      "vmaf",
      "pyscenedetect"
    ]
  },
  "omegaBridge": {
    "manifest": "config/rechercher-omega-media-bridge-2026.json",
    "aiPr": 566,
    "executionPr": 603,
    "mode": "stacked-branches",
    "aiLayer": [
      "Qwen",
      "Wan2.2",
      "HunyuanVideo-1.5",
      "LTX-2",
      "CogVideoX",
      "Whisper",
      "CosyVoice",
      "FLUX",
      "PaddleOCR-VL"
    ],
    "executionLayer": [
      "Kdenlive",
      "Blender",
      "OBS",
      "Ardour",
      "Audacity",
      "GIMP",
      "Inkscape",
      "Glaxnimate",
      "ImageMagick",
      "OpenTimelineIO",
      "OpenColorIO",
      "FFmpeg",
      "MediaMTX"
    ],
    "executionBranch": "feat/omega-media-conversation-final-2026-v2"
  },
  "conversationRuntime": {
    "manifest": "config/rechercher-omega-conversation-runtime-2026.json",
    "releaseTag": "dinullah-conversation-runtime-v2026.09.29",
    "weightsTag": "dinullah-conversation-weights-v2026.09.29",
    "functions": [
      "microphone",
      "realtime-webrtc",
      "vad",
      "asr",
      "language-detection",
      "international-translation",
      "tts",
      "captions",
      "live-translation",
      "lip-sync-dubbing"
    ],
    "aiBranchPr": 566,
    "tools": [
      "whisperx",
      "kokoro"
    ]
  },
  "resourceAdmission": {
    "manifest": "config/rechercher-omega-resource-and-cache-2026.json",
    "liveObservationRequired": true,
    "pools": {
      "local_cpu": {
        "max_concurrency": 2
      },
      "local_gpu": {
        "max_concurrency": 1
      },
      "local_comfyui": {
        "max_concurrency": 1
      },
      "kaggle_gpu": {
        "max_concurrency": 1
      },
      "api": {
        "max_concurrency": 4
      }
    },
    "saturationAction": "queue"
  }
}
