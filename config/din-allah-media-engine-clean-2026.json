{
  "engine": "Din Allah Media Engine",
  "version": "1.0.0",
  "build": "clean-2026",
  "base": "main",
  "separation": {
    "corpusMutation": false,
    "rechercherMutation": false,
    "acquisitionBlocking": false,
    "generatedMediaCommitted": false,
    "runtimeDependencyAdded": false
  },
  "pipeline": ["brief","evidence_packet","storyboard","visual_source","quality_evaluation","quran_text","verified_recitation","sync","composition","master_validation","human_review","export"],
  "visualSources": ["original","self-hosted-generation","imported"],
  "quran": {
    "generatedText": false,
    "generatedRecitation": false,
    "canonicalArabicVerbatim": true,
    "recitationLanguage": "ar"
  },
  "benchmarks": {
    "primary": "VBench-2.0",
    "secondary": "VBench",
    "ciDownloadsModels": false
  },
  "customGates": ["quranTextIntegrity","recitationIntegrity","provenance","rights","unintendedGeneratedText","temporalConsistency","audioStreamIntegrity"],
  "exports": ["mp4","webm"],
  "futureAdapters": ["video-generation","visual-import","ocr","recitation","audio-sync","composition","export"]
}