{
  "schemaVersion": "1.0.0",
  "purpose": "Fill unanswered question areas inside the original PDF page without reflowing or rebuilding the surrounding content.",
  "inputInvariant": {
    "preserveOriginalPageGeometry": true,
    "preserveOriginalVisibleContent": true,
    "preserveOriginalReadingOrder": true,
    "neverReplaceWholePage": true
  },
  "pipeline": [
    "render-source-page-if-image-only",
    "layout-detection",
    "multi-engine-ocr",
    "question-region-detection",
    "answer-region-detection",
    "evidence-retrieval",
    "answer-generation-with-evidence",
    "answer-verification",
    "remove-only-answer-guide-marks",
    "insert-answer-into-original-region",
    "roundtrip-visual-and-ocr-check"
  ],
  "engines": {
    "layout": [
      {"project":"PaddlePaddle/PaddleOCR", "role":"layout_and_geometry"},
      {"project":"docling-project/docling", "role":"document_structure_and_reading_order"}
    ],
    "ocr": [
      {"project":"PaddlePaddle/PaddleOCR", "role":"primary"},
      {"project":"tesseract-ocr/tesseract", "role":"independent_cross_check"}
    ],
    "guideLineRemoval": [
      {"project":"advimman/lama", "role":"local_inpainting_for_image_only_pages"},
      {"project":"opencv/opencv", "role":"deterministic_thin_line_cleanup"}
    ],
    "pdfRendering": [
      {"project":"pymupdf/PyMuPDF", "role":"in_place_text_insertion_and_pdf_roundtrip"}
    ],
    "retrieval": [
      {"project":"Meilisearch", "role":"lexical_evidence"},
      {"project":"Qdrant", "role":"semantic_evidence"}
    ]
  },
  "answerPlacement": {
    "anchor": "original_answer_region",
    "numberAnswers": true,
    "keepExistingQuestionAndContext": true,
    "fontPolicy": "fit-to-region-with-readable-minimum",
    "rtl": true,
    "collisionCheck": true,
    "overflowPolicy": "reduce-font-then-split-within-original-region; otherwise needs_review",
    "neverMoveOtherPageContent": true
  },
  "sourcePreservation": {
    "retainOriginalPdf": true,
    "retainSourcePageHash": true,
    "recordEditedRegions": true,
    "recordAnswerEvidence": true,
    "recordModelVersions": true
  },
  "qualityGates": {
    "noTextOutsideTargetRegionChanged": true,
    "noQuestionTextChanged": true,
    "noReferenceLineChanged": true,
    "visualDiffOutsideEditedRegionsMustBeZeroOrNearZero": true,
    "postRenderOcrRoundTripRequired": true,
    "unresolvedAnswerIsNeverGuessed": true
  },
  "rights": {
    "originalRightsRemainUnchanged": true,
    "derivedRedistributionRequiresRightsCheck": true
  }
}
