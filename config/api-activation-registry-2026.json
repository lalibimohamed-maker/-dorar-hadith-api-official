{
  "version": "2026.24",
  "policy": {
    "lifecycle": ["registered","implemented","runtime","rechercher","verification","acquisition","release","search_encyclopedia"],
    "corpus_write": "never-direct",
    "storage_write": "rights-and-provenance-gated"
  },
  "connectors": [
    {
      "id": "quran-foundation",
      "registered": true,
      "implemented": true,
      "runtime": true,
      "rechercher": true,
      "verification": true,
      "acquisition": false,
      "release": false,
      "search_encyclopedia": true,
      "capabilities": ["quran-text","translations","tafsir","search","audio","word-level-data","content-sync"],
      "auth": "backend-credentials",
      "canonical_policy": "arabic-quran-remains-separate-from-translations"
    },
    {
      "id": "quranenc",
      "registered": true,
      "implemented": true,
      "runtime": true,
      "rechercher": true,
      "verification": true,
      "acquisition": false,
      "release": false,
      "search_encyclopedia": true,
      "capabilities": ["translations","translation-catalogue"],
      "auth": "public-api"
    },
    {
      "id": "dorar-hadith",
      "registered": true,
      "implemented": true,
      "runtime": true,
      "rechercher": true,
      "verification": true,
      "acquisition": false,
      "release": false,
      "search_encyclopedia": true,
      "capabilities": ["hadith-search","grading","source-location","scholarly-comments"],
      "auth": "public-api"
    },
    {
      "id": "sunnah-com",
      "registered": true,
      "implemented": true,
      "runtime": true,
      "rechercher": true,
      "verification": true,
      "acquisition": false,
      "release": false,
      "search_encyclopedia": true,
      "capabilities": ["hadith-collections","hadith-records"],
      "auth": "api-key",
      "availability": "portion-of-data"
    }
  ]
}
