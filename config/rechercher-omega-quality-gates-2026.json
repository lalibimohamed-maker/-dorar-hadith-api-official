{
  "schema_version": "1.0.0",
  "id": "rechercher-omega-quality-gates-2026",
  "purpose": "Fail-closed quality gates for generated media and evidence-bound AI answers.",
  "media": {
    "measurement": "full_reference_when_reference_available",
    "engines": [
      "vmaf",
      "ffmpeg",
      "whisperx"
    ],
    "thresholds": {
      "vmaf_min": 85,
      "ssim_min": 0.95,
      "subtitle_drift_ms_max": 120
    },
    "missing_metrics_action": "blocked"
  },
  "answer": {
    "evaluation": [
      "evidence_fidelity",
      "unsupported_claim_detection",
      "citation_coverage"
    ],
    "thresholds": {
      "unsupported_claims_max": 0,
      "citation_coverage_min": 1
    },
    "missing_metrics_action": "blocked"
  },
  "policy": {
    "resolution_is_not_quality_proof": true,
    "generated_media_is_evidence": false,
    "corpus_write_allowed": false,
    "quality_failure_never_auto_promotes_output": true
  }
}
