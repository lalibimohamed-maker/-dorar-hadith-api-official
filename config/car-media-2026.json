{
  "version":"2026-08-30",
  "purpose":"Free-first in-car media capability layer for Quran audio and authorized video, using native vehicle integrations when available and never bypassing driver-safety restrictions.",
  "principles":{
    "paidApiRequired":false,
    "subscriptionRequired":false,
    "preserveOriginalMedia":true,
    "noArtificialMediaResolutionCeiling":true,
    "bluetoothIsAudioControlTransport":true,
    "videoRequiresDisplayCapableTransport":true,
    "videoWhileDriving":"blocked-by-default"
  },
  "transports":{
    "usb":{
      "roles":["wired-phone-car-bridge","direct-media-transfer","display-link-when-supported"],
      "capabilities":["audio","media-controls","android-auto-or-equivalent","carplay-or-equivalent","usb-c-displayport-when-hardware-supports"],
      "qualityPolicy":"negotiate-with-vehicle-and-device"
    },
    "bluetooth":{
      "roles":["audio-output","media-control"],
      "profiles":["A2DP","AVRCP","LE-Audio-when-supported"],
      "capabilities":["quran-audio","play-pause","next-previous","metadata-when-supported"],
      "video":false,
      "qualityPolicy":"negotiate-codec-and-sink-capability"
    },
    "wifi-native-car":{
      "roles":["platform-display","media-control","streaming-when-supported"],
      "qualityPolicy":"capability-probed"
    }
  },
  "carPlatforms":{
    "android-auto":{
      "audio":"MediaLibraryService+MediaSession",
      "video":"parked-only-video-category-when-supported",
      "status":"adapter",
      "source":"https://developer.android.com/training/cars/media"
    },
    "android-automotive-os":{
      "audio":"MediaLibraryService+MediaSession",
      "video":"parked-only-video-category-when-supported",
      "status":"adapter",
      "source":"https://developer.android.com/media/implement/surfaces/cars"
    },
    "carplay":{
      "audio":"CarPlay-audio-app",
      "video":"supported-cars-when-parked",
      "status":"adapter",
      "source":"https://developer.apple.com/carplay/"
    }
  },
  "quranAudio":{
    "sourceRule":"verified-recitation-only",
    "generatedSpeech":"forbidden",
    "nativeAudioPreserved":true,
    "transports":["usb","bluetooth","wifi-native-car"],
    "driverMode":"audio-first",
    "autoplayOnConnection":false,
    "voiceSearchWhenSupported":true,
    "metadata":["surah","ayah","reciter","edition","source","sha256"]
  },
  "video":{
    "allowedContexts":["parked","vehicle-system-explicitly-permits-video"],
    "blockedContext":"driving",
    "transports":["usb","wifi-native-car"],
    "bluetooth":false,
    "nativeQualityPolicy":"preserve-master-and-negotiate-derivative",
    "qualityTiers":["native","4K","8K","12K","16K","24K","future"],
    "neverClaimNativeWithoutSourceEvidence":true
  },
  "deviceClasses":["iphone","ipad","android-phone","android-tablet","car-head-unit","android-automotive","carplay-head-unit"],
  "safety":{
    "explicitUserActionForPlayback":true,
    "noScreenVideoWhileDriving":true,
    "doNotBypassCarSafetyPolicy":true,
    "sessionRevocation":true,
    "unknownCapability":"blocked"
  },
  "freeFirst":{
    "localPlaybackPreferred":true,
    "platformAdaptersOptional":true,
    "paidCloudDependency":false
  }
}
