  "lessonSeeds": {
    "prophetic_prayer": {
      "title":"صفة صلاة النبي صلى الله عليه وسلم",
      "steps":[
        {"objective":"الاستعداد للصلاة","instruction":"تحقق من دخول الوقت والطهارة وستر العورة واستقبال القبلة بحسب حال المصلي.","evidence":[{"kind":"quran","references":["4:103","2:238"]}]},
        {"objective":"تكبيرة الإحرام والقيام","instruction":"ابدأ الصلاة بالتكبير، ثم طبّق صفة القيام والقراءة كما وردت في السنة.","evidence":[{"kind":"hadith","source":"Sahih al-Bukhari","reference":"631","grade":"صحيح"}]},
        {"objective":"الركوع والسجود","instruction":"تعلّم الانتقال والطمأنينة وأداء الركوع والسجود على الصفة الموثقة، مع تدريب بصري لا يضيف هيئة غير ثابتة.","evidence":[{"kind":"hadith","source":"Sahih al-Bukhari","reference":"631","grade":"صحيح"}]},
        {"objective":"الخشوع","instruction":"تدرّب على حضور القلب وفهم ما تقرأ، ويعرض النظام نصوص فضائل الخشوع دون ادعاء طريقة حسية خاصة لم تثبت.","evidence":[{"kind":"quran","references":["23:1-2"]}]}
      ]
    },
    "prayer_times": {
      "title":"مواقيت الصلوات الخمس",
      "steps":[
        {"objective":"فهم أصل المواقيت","instruction":"يتعلم المستخدم أن الصلاة فُرضت في أوقات محددة، ثم يستخدم التطبيق الحساب الفلكي لعرض الوقت المحلي مع بيان طريقة الحساب.","evidence":[{"kind":"quran","references":["4:103","17:78"]}]},
        {"objective":"تطبيق الوقت المحلي","instruction":"يعرض التطبيق الفجر والشروق والظهر والعصر والمغرب والعشاء حسب الموقع الذي يختاره المستخدم، مع إمكان تعديل طريقة الحساب وفق الإعدادات المعتمدة.","evidence":[{"kind":"quran","references":["17:78"]}]}
      ]
    },
    "prohibited_times": {
      "title":"أوقات النهي عن الصلاة",
      "steps":[
        {"objective":"معرفة الأوقات المنهي عنها","instruction":"يتعلم المستخدم الأوقات التي ورد النهي عن الصلاة فيها، مع التفريق بين النهي المطلق وما استثناه الدليل.","evidence":[{"kind":"hadith","source":"Sahih Muslim","reference":"831","grade":"صحيح"}]},
        {"objective":"تطبيقها على الوقت المحلي","instruction":"يربط التطبيق وقت النهي بالشروق والغروب الحقيقيين في موقع المستخدم بدلاً من استخدام ساعة ثابتة.","evidence":[{"kind":"hadith","source":"Sahih Muslim","reference":"831","grade":"صحيح"}]}
      ]
    },
    "fajr_taghlees_isfar": {
      "title":"الفجر: التغليس والإسفار",
      "steps":[
        {"objective":"فهم المصطلحين","instruction":"يشرح التطبيق الفرق بين التغليس والإسفار كما استعملهما أهل العلم في باب صلاة الفجر، ثم يعرض النصوص المتعلقة بوقت الفجر.","evidence":[{"kind":"hadith","source":"Sahih al-Bukhari","reference":"578","grade":"صحيح"}]},
        {"objective":"التطبيق العملي","instruction":"يُعرض وقت الفجر والشفق في الموقع المحلي، ويُذكر أن الحساب التقريبي لا يغني عن ضبط الوقت المعتمد في البلد.","evidence":[{"kind":"hadith","source":"Sahih Muslim","reference":"645","grade":"صحيح"}]}
      ]
    },
    "traveler_prayer": {
      "title":"صلاة المسافر: القصر والجمع",
      "steps":[
        {"objective":"معرفة أصل القصر","instruction":"يتعلم المسافر أصل مشروعية القصر، ثم يحدد حال السفر والمسافة والعرف وما عليه الجهة الفقهية التي يتبعها.","evidence":[{"kind":"quran","references":["4:101"]},{"kind":"hadith","source":"Sahih Muslim","reference":"686","grade":"صحيح"}]},
        {"objective":"فهم الجمع","instruction":"يفصل التطبيق بين القصر والجمع، لأنهما حكمان مختلفان، ويعرض حالات الجمع الثابتة والخلاف الفقهي المعتبر.","evidence":[{"kind":"hadith","source":"Sahih Muslim","reference":"686","grade":"صحيح"}]}
      ]
    },
    "eclipse": {
      "title":"صلاة الكسوف والخسوف",
      "steps":[
        {"objective":"معرفة سبب الصلاة","instruction":"يتعلم المستخدم أن الكسوف آية من آيات الله وأن المشروع عند وقوعه الصلاة والذكر والدعاء.","evidence":[{"kind":"hadith","source":"Sahih al-Bukhari","reference":"1040","grade":"صحيح"}]},
        {"objective":"التطبيق العملي","instruction":"يعرض التطبيق خطوات الصلاة على هيئة تفاعلية مع ربط كل خطوة بالدليل، دون إضافة تفاصيل غير موثقة.","evidence":[{"kind":"hadith","source":"Sahih al-Bukhari","reference":"1040","grade":"صحيح"}]}
      ]
    }
  }
}
