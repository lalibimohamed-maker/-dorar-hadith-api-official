{
  "schemaVersion":"1.0.0",
  "id":"rechercher-omega-media-infrastructure-2026",
  "role":"universal-local-first-media-execution-infrastructure",
  "layers":{
    "brain":{"pr":566,"role":"planning-routing-provenance-gates"},
    "interoperability":{"pr":600,"role":"open-media-runtimes-release-backed-software-and-weight-artifacts"},
    "execution":{"pr":613,"role":"unified-job-runtime-resource-and-cancellation-plane"},
    "distribution":{"prs":[609,610,611,612],"role":"offline-artifact-distribution"}
  },
  "executionPipeline":[
    "request-normalization",
    "capability-resolution",
    "engine-identity-resolution",
    "artifact-integrity-gate",
    "license-rights-gate",
    "resource-fit",
    "runtime-health",
    "load",
    "execute",
    "output-validation",
    "provenance-record",
    "derived-artifact-publication"
  ],
  "engineLifecycle":["registered","installed","verified","active"],
  "resourcePolicy":{
    "supportedKinds":["browser-wasm","browser-webgpu","local-cpu","local-gpu","remote-gpu"],
    "localFirst":true,
    "offlinePreferredWhenVerified":true,
    "noPaidProviderRequired":true,
    "strictCapacityMatching":true
  },
  "artifactPolicy":{
    "largeBinaries":"github-releases-only",
    "gitWeightsForbidden":true,
    "sha256Required":true,
    "sourceRevisionRequired":true,
    "licenseEvidenceRequired":true,
    "ambiguousRights":"blocked-or-review-only",
    "existenceAndRightsAreSeparate":true
  },
  "mediaPolicy":{
    "generatedMediaIsDerived":true,
    "generatedMediaIsNotScholarlyEvidence":true,
    "directCorpusWrite":false,
    "provenanceRequired":true
  },
  "speechPolicy":{
    "userSelectableEngines":true,
    "userSelectableVoices":true,
    "multilingual":true,
    "ttsAndHumanRecitationAreSeparate":true,
    "quranRecitationRequiresVerifiedHumanRecording":true
  },
  "observability":{
    "requiredJobFields":["job_id","state","capability","engine_id","resource_id","created_at","completed_at"],
    "failureModes":["blocked","failed","cancelled","no-compatible-resource","runtime-not-ready","artifact-unverified","license-unverified"],
    "noFalseSuccess":true
  },
  "corpusBoundary":{
    "canonicalCorpusRemainsSourceOfTruth":true,
    "mediaRuntimeCannotMutateCorpus":true
  }
}
