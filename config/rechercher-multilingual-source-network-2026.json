    "classical-books","modern-books","translations","terminology","dawah-and-education","libraries-and-catalogues",
    "scholarly-articles","manuscripts-and-editions","audio-and-recitation","encyclopedias-and-reference"
  ],
  "pipeline": [
    "primary-or-institutional-source","api","corpus","structured-web","scholarly-dataset",
    "translation-metadata","provenance","rights","verification"
  ],
  "translation_states": [
    "source-verified","institutionally-reviewed","scholarly","provenance-complete","candidate","machine-translated","unverified"
  ],
  "canonical_separation": {
    "canonical_arabic_quran": "immutable-source-layer",
    "translation": "separate-record-referencing-canonical-verse",
    "machine_translation": "separate-record-never-promoted-automatically"
  },
  "quran_foundation": {
    "enabled": true,
    "adapter": "content-api-v4",
    "sync_groups": ["translations","tafsirs","word_by_word_translations","word_by_word_transliterations"],
    "auth": "backend-only-client-credentials",
    "credentials": {"client_id_env":"QF_CLIENT_ID","client_secret_env":"QF_CLIENT_SECRET"},
    "base_urls": {"production":"https://apis.quran.foundation","prelive":"https://apis-prelive.quran.foundation"},
    "provenance_required": true,
    "rights_required": true
  },
  "expansion": {
    "language_ceiling": null,
    "discovery_sources": ["institutional-catalogues","library-metadata","scholarly-datasets","translation-catalogues","structured-web","publisher-catalogues"],
    "rule": "Every newly verified language is added as a new independent lane across all 24 domains; missing translations become translation-needed rather than being discarded."
  },
  "rights_policy": "Discovery does not imply redistribution. Public full-text acquisition requires item/source-level rights or explicit permission.",
  "corpus_boundary": "This registry and its derived queues are a system-layer index. They do not replace, rewrite, or mix into the canonical corpus."
}
