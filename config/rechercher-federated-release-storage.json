{
  "schema":"din-allah/rechercher-federated-release-storage/v2",
  "storage_model":"federated-release-assets","corpus_policy":"metadata-index-only","lfs_policy":"large-files-needing-git-versioning-only","actions_artifacts_policy":"ephemeral-processing-results-only","research_vault_policy":"non-public-material-never-published-as-plaintext-release-asset","public_pdf_policy":"only-verified-redistributable",
