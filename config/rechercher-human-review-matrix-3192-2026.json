{
  "schema": "rechercher/human-review-matrix/v1",
  "version": "2026.09.19",
  "matrix": {
    "languageCells": 132,
    "domainCells": 24,
    "totalCells": 3192
  },
  "rule": "Every cell requires an explicit human reviewer attestation before authoritative promotion.",
  "statuses": [
    "UNREVIEWED",
    "CANDIDATE",
    "SOURCE_VERIFIED",
    "PROVENANCE_COMPLETE",
    "HUMAN_REVIEWED",
    "VERIFIED",
    "REJECTED"
  ],
  "requiredEvidence": [
    "source_identity",
    "provenance",
    "rights",
    "verification_evidence"
  ],
  "humanReview": {
    "requiredForAuthoritativeUse": true,
    "attestationRequired": true,
    "attestationFields": [
      "reviewer_id",
      "reviewed_at",
      "decision",
      "evidence_refs",
      "notes"
    ],
    "noSyntheticAttestation": true
  },
  "promotion": {
    "automatic": false,
    "requiredStatus": "HUMAN_REVIEWED",
    "rightsMustBe": "ALLOWED"
  },
  "integrity": {
    "canonicalQuranArabicImmutable": true,
    "originalPdfImmutable": true,
    "sourceIdentityImmutable": true
  },
  "coverage": {
    "languageRegistrySource": "config/language-coverage-2026.json",
    "domainRegistrySource": "config/encyclopedia-domain-ontology-2026.json",
    "languageCountMustEqual": 132,
    "domainCountMustEqual": 24
  },
  "execution": {
    "mode": "build-review-queue-and-verify-attestations",
    "failClosed": true,
    "neverMarkHumanReviewedWithoutAttestation": true
  }
}
