{
  "schemaVersion": "1.0",
  "status": "OPEN_EXTENSION_POINT",
  "purpose": "Rights-aware worldwide discovery registry for high-quality books, manuscripts and scholarly source records. Discovery must never block lawful PDF acquisition.",
  "acquisitionPrinciple": {
    "priority": [
      "official_direct_pdf",
      "official_iiif_manifest_and_images",
      "official_open_repository",
      "public_domain_or_explicit_open_license",
      "catalog_record_reference_only"
    ],
    "neverPublish": ["UNKNOWN", "RESTRICTED", "EXPLICIT_PERMISSION_REQUIRED"],
    "neverBypass": ["access_controls", "robots_or_rate_limits", "copyright_or_license_restrictions"],
    "noProxyRotation": true,
    "noUserAgentRotation": true
  },
  "qualityPolicy": {
    "prefer": [
      "complete_volume_set",
      "highest_available_resolution",
      "original_page_images",
      "official_pdf",
      "lossless_or_minimally_lossy_derivative",
      "stable_identifier",
      "page_level_manifest",
      "verified_bibliographic_metadata"
    ],
    "validation": ["pdf_signature", "qpdf_check", "page_count", "content_hash", "identity_match", "rights_evidence"],
    "retainOriginalPdf": true,
    "encryptedPdfEncForbidden": true
  },
  "providers": [
    {"id":"iiif_biblissima","type":"IIIF_AGGREGATOR","scope":"MANUSCRIPTS_RARE_BOOKS","priority":10,"discovery":"IIIF_MANIFEST","download":"SOURCE_DEPENDENT","rights":"SOURCE_RECORD"},
    {"id":"gallica_bnf","type":"NATIONAL_LIBRARY","scope":"BOOKS_MANUSCRIPTS","priority":10,"discovery":"CATALOG_IIIF","download":"PDF_OR_IIIF","rights":"ITEM_LICENSE"},
    {"id":"digital_bodleian","type":"UNIVERSITY_LIBRARY","scope":"MANUSCRIPTS_BOOKS","priority":10,"discovery":"IIIF","download":"IIIF","rights":"ITEM_LICENSE"},
    {"id":"bayerische_staatsbibliothek","type":"NATIONAL_LIBRARY","scope":"MANUSCRIPTS_BOOKS","priority":10,"discovery":"IIIF_CATALOG","download":"SOURCE_DEPENDENT","rights":"ITEM_LICENSE"},
    {"id":"loc","type":"NATIONAL_LIBRARY","scope":"BOOKS_MANUSCRIPTS","priority":10,"discovery":"API_IIIF","download":"PDF_OR_IIIF","rights":"ITEM_RIGHTS"},
    {"id":"arabic_collections_online","type":"UNIVERSITY_LIBRARY_AGGREGATOR","scope":"ARABIC_BOOKS","priority":10,"discovery":"CATALOG_IIIF","download":"HIGH_RES_PDF_WHEN_AVAILABLE","rights":"ITEM_LICENSE"},
    {"id":"al_furqan","type":"ISLAMIC_HERITAGE_GATEWAY","scope":"ISLAMIC_MANUSCRIPTS_BOOKS","priority":9,"discovery":"CATALOG","download":"SOURCE_DEPENDENT","rights":"ITEM_LICENSE"},
    {"id":"kairawan","type":"MANUSCRIPT_AGGREGATOR","scope":"ARABIC_ISLAMIC_MANUSCRIPTS","priority":9,"discovery":"CATALOG","download":"HOLDING_LIBRARY","rights":"HOLDING_LIBRARY"},
    {"id":"open_library","type":"LIBRARY_CATALOG","scope":"BOOKS","priority":8,"discovery":"API","download":"SOURCE_DEPENDENT","rights":"ITEM_LICENSE"},
    {"id":"internet_archive","type":"DIGITAL_LIBRARY","scope":"BOOKS_MANUSCRIPTS","priority":8,"discovery":"ADVANCED_SEARCH_API","download":"PDF_WHEN_AVAILABLE","rights":"ITEM_RECORD"},
    {"id":"google_books","type":"BOOK_SEARCH","scope":"BOOKS","priority":8,"discovery":"BOOKS_API","download":"FULL_VIEW_ONLY_WHEN_ALLOWED","rights":"GOOGLE_BOOKS_STATUS"},
    {"id":"europeana","type":"CULTURAL_HERITAGE_AGGREGATOR","scope":"BOOKS_MANUSCRIPTS_MEDIA","priority":8,"discovery":"API_IIIF","download":"SOURCE_DEPENDENT","rights":"ITEM_RECORD"},
    {"id":"dpla","type":"CULTURAL_HERITAGE_AGGREGATOR","scope":"DIGITIZED_BOOKS_MANUSCRIPTS","priority":8,"discovery":"API","download":"SOURCE_DEPENDENT","rights":"ITEM_RECORD"},
    {"id":"openiti","type":"ISLAMIC_CORPUS","scope":"ISLAMIC_TEXTS","priority":9,"discovery":"CORPUS_METADATA","download":"CORPUS_FILES","rights":"CORPUS_LICENSE"}
  ],
  "recordModel": {
    "required": ["source_id","work_id","edition_id","manifestation_id","source_uri","retrieval_date","content_hash","rights_state","rights_evidence","provenance"],
    "optional": ["page_id","passage_id","iiif_manifest","pdf_uri","image_uri","text_uri","audio_uri","video_uri","language","script","institution","shelfmark","catalog_id","quality_score","resolution_dpi","page_count"]
  },
  "qualityScore": {
    "factors": ["completeness","resolution","page_legibility","bibliographic_identity","source_stability","provenance_strength","rights_clarity","text_extractability"],
    "selectionRule": "prefer the highest verified score among lawful equivalent manifestations; retain alternative lawful manifestations for scholarly comparison"
  }
}
