{
  "schema": "din-allah-encyclopedia/rechercher-pdf-storage/v4-three-place-two-route",
  "primary_repository": "lalibimohamed-maker/-dorar-hadith-api-official",
  "secondary_storage_repository": "lalibimohamed82-coder/rechercher-pdf-storage",
  "purpose": "Three independent storage places, each exposing a public route and a protected developer route. Routes are complementary, never mirrored, and never write to the scientific Corpus.",
  "format": ".pdf",
  "content_addressing": "sha256-for-integrity-only",
  "storage_contract": {
    "primary": "artifacts/*.pdf",
    "secondary": "artifacts/*.pdf",
    "one_copy_only": true,
    "distribution": "Each verified PDF is assigned deterministically to exactly one pool from its SHA-256; it is never copied to the other pool.",
    "verified_pdfs_only": true,
    "real_pdf_signature_required": true,
    "qpdf_validation_required": true,
    "encrypted_files_forbidden": true,
    "storage_content_only_pdf": true,
    "sha256_is_not_a_storage_path": true,
    "source_provider_not_fixed": true,
    "source_failover": "immediate next independent catalogued source on restriction/failure",
    "no_source_quota": "the engine does not stop after a provider-specific book count"
  },
  "activation": {
    "public_pdf_repository_verified": "lalibimohamed-maker/dinullah-pdf-storage-01",
    "matrix_repository_verified": "lalibimohamed-maker/dinullah-matrix-3192-storage-01",
    "protected_secondary_repository": "lalibimohamed82-coder/rechercher-pdf-storage",
    "protected_repository_visibility": "must be verified by the write token at runtime; fail closed if unavailable",
    "matrix_and_pdf_are_separate": true
  },
  "failure_policy": "If the selected public or protected route cannot be proven accessible and appropriate, fail closed. Never create a second PDF copy as fallback.",
  "storage_places": [
    {
      "id": "secondary-account-storage",
      "role": "secondary-account-permanent-pdf-storage",
      "public_route": {
        "type": "repository",
        "repository": "lalibimohamed-maker/dinullah-pdf-storage-01",
        "path": "artifacts/public/*.pdf",
        "policy": "public-eligible-only"
      },
      "protected_route": {
        "type": "repository",
        "repository": "lalibimohamed82-coder/rechercher-pdf-storage",
        "path": "artifacts/protected/*.pdf",
        "policy": "developer-access-only; rights-unclear-or-restricted"
      }
    },
    {
      "id": "dinullah-pdf-storage-01",
      "role": "dedicated-public-pdf-storage",
      "public_route": {
        "type": "repository",
        "repository": "lalibimohamed-maker/dinullah-pdf-storage-01",
        "path": "artifacts/public/*.pdf",
        "policy": "public-eligible-only"
      },
      "protected_route": {
        "type": "logical-route",
        "repository": "lalibimohamed82-coder/rechercher-pdf-storage",
        "path": "artifacts/protected/*.pdf",
        "policy": "developer-access-only; same canonical PDF is never duplicated"
      }
    },
    {
      "id": "dinullah-matrix-3192-storage-01",
      "role": "3192-cell-matrix-storage",
      "public_route": {
        "type": "repository",
        "repository": "lalibimohamed-maker/dinullah-matrix-3192-storage-01",
        "path": "artifacts/public/*.pdf",
        "policy": "only matrix outputs explicitly cleared for publication"
      },
      "protected_route": {
        "type": "logical-route",
        "repository": "lalibimohamed82-coder/rechercher-pdf-storage",
        "path": "artifacts/protected/matrix/*.pdf",
        "policy": "developer-access-only; matrix artifacts remain separate from Corpus"
      }
    }
  ],
  "route_contract": {
    "one_physical_pdf_only": true,
    "sha256": "identity-and-integrity; never a storage path",
    "public_eligible": "public route only",
    "protected_or_rights_unclear": "protected route only",
    "duplicate_across_public_and_protected": false,
    "corpus_write": false,
    "encrypted_pdf_forbidden": true,
    "developer_access": {
      "public_routes": true,
      "protected_routes": true
    },
    "protected_storage_note": "The protected route must resolve to a permissioned/private storage repository. A public GitHub repository or public release asset is never treated as protected."
  }
}
