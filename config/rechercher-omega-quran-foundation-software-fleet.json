      "client": "Invoke-RestMethod"
    }
  ],
  "runtime_rules": {
    "backend": "When Content or Search is required, use the server runtime and keep client credentials server-side.",
    "browser_mobile": "Use the public runtime only for flows explicitly supported for public clients; PKCE does not make a client_secret safe to ship.",
    "edge": "Workers/serverless can run the server SDK when secrets are provided by the platform secret manager.",
    "python_kaggle": "Suitable for controlled research/batch jobs; never place client secrets or access tokens in public notebooks, logs or artifacts."
  },
  "auth_lifecycle": [
    "documented",
    "environment_selected",
    "credentialed",
    "token_acquired",
    "scope_verified",
    "endpoint_contract_verified",
    "provenance_verified",
    "rights_verified",
    "acquisition_allowed"
  ],
  "sync_rules": {
    "source_of_truth": "Quran Foundation server content",
    "local_role": "readable cache",
    "state_separation": "sync state must be separate from cached rows",
    "idempotency_key": "resourceGroup + resourceId + recordType + recordKey",
    "incremental_preference": true,
    "snapshot_replacement": "replace a full resource atomically when snapshot_url is returned",
    "recovery": "re-bootstrap/full-copy when incremental state is invalid"
  },
  "fleet_consumers": [
    "@Rechercher source/API connectors",
    "Rechercher Ω model/tool agents",
    "Dinullah Matrix multilingual resource workers",
    "Quran reader/search web application",
    "mobile/offline applications",
    "voice interface surfaces such as يا بوابة العلم",
    "developer examples and integration tests"
  ],
  "source_links": {
