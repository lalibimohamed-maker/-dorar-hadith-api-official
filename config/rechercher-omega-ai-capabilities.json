{
  "schema_version": "1.0.0",
  "purpose": "Reusable open-source AI capability registry for Rechercher Omega. Components are adapters/workers, never scholarly sources.",
  "policy": {
    "free_first": true,
    "prefer_local": true,
    "secret_harvesting": false,
    "public_secret_use": false,
    "external_code_auto_execution": false,
    "model_weight_license_separate": true,
    "generated_media_is_evidence": false,
    "corpus_write_allowed": false
  },
