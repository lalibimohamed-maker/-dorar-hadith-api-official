      "tasks": [
        "wake_word"
      ],
      "integration": "runtime_reference",
      "auto_download": false,
      "notes": "Repository code is Apache-2.0; bundled pretrained wake-word models have more restrictive licensing, so only the runtime/code path is enabled automatically."
    },
