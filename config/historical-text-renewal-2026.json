{
  "schemaVersion":"1.0.0",
  "version":"2026-08-30",
  "name":"historical-text-renewal-engine",
  "purpose":"Create a clean, legible, newly typeset reading edition from degraded historical pages while preserving the original textual content and complete provenance.",
  "freeFirst":true,
  "noPaidDependencyRequired":true,
  "separationOfConcerns":{
    "sourceImage":"immutable",
    "diplomaticText":"immutable_semantic_record",
    "renewedText":"derived_representation",
    "visualRestoration":"must_not_change_text_identity",
    "ocr":"candidate_and_verification_only"
  },
  "restorationStages":[
    "page_classification",
    "illumination_normalization",
    "background_estimation",
    "ink_background_separation",
    "noise_and_spot_suppression",
    "bleed_through_suppression",
    "deblur_when_quality_gate_passes",
    "defade_and_local_contrast",
    "deskew",
    "dewarp",
    "glyph_stroke_recovery",
    "historical_layout_analysis",
    "multi_engine_ocr_verification",
    "text_consensus",
    "diplomatic_text_lock",
    "renewed_typesetting",
    "visual_diff",
    "artifact_integrity"
  ],
  "renewalRules":{
    "sameTextNotSamePixels":true,
    "preserveWordsAndOrder":true,
    "preserveMeaningfulDiacritics":true,
    "preserveHeadingsFootnotesMarginaliaWhenDetected":true,
    "materialCharacterRepairRequiresEvidence":true,
    "ambiguousCharacterIsNotGuessed":true,
    "missingTextRequiresIndependentEvidence":true,
    "allRepairsAreTraceable":true
  },
  "readingEdition":{
    "enabled":true,
    "background":"warm-light-yellow-low-saturation",
    "text":"clean-high-contrast-digital-typesetting",
    "avoidAggressivePureWhiteBackground":true,
    "preserveIllustrations":true,
    "preserveMargins":true,
    "preservePageSemanticStructure":true,
    "fontChoiceMustSupportArabicAndHistoricalPunctuation":true
  },
  "qualityGates":[
    "source_hash_unchanged",
    "page_count_unchanged",
    "layout_review_pass",
    "ocr_cross_engine_pass_or_quarantine",
    "diplomatic_text_unchanged",
    "material_repairs_provenanced",
    "visual_difference_outside_allowed_regions_rejected",
    "output_openability_pass",
    "rights_pass"
  ],
  "researchReferences":[
    "OCR4all",
    "OCR-D",
    "ScanTailor-Advanced",
    "OpenCV",
    "Kraken",
    "Calamari",
    "Docling"
  ]
}
