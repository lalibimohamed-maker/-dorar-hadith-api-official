{
  "stage": "V9_MULTIMODAL_ISLAMIC_LEARNING",
  "version": "9.1.0",
  "status": "IMPLEMENTED_FOUNDATION",
  "scope": ["text", "pdf", "image", "manuscript", "audio", "recitation", "video", "dialogue"],
  "pipeline": [
    "MEDIA_IDENTITY",
    "PREPROCESSING",
    "FEATURE_EXTRACTION",
    "SIGNAL_ALIGNMENT",
    "PROVENANCE",
    "MODALITY_FUSION",
    "CANDIDATE_FINDING",
    "GUARDRAILS",
    "HUMAN_REVIEW",
    "VERIFICATION",
    "FEEDBACK_LOOP",
    "ACTIVE_LEARNING",
    "MODEL_EVALUATION"
  ],
  "sourceIdentity": ["source_id", "work_id", "edition_id", "manifestation_id", "page_id", "passage_id", "language", "license", "rights", "provenance", "retrieval_date", "content_hash"],
  "preprocessing": {
    "normalization": ["container_decode", "format_normalization", "sample_rate_normalization", "channel_normalization", "image_orientation", "image_dimensions", "video_frame_sampling", "pdf_page_rendering", "text_normalization"],
    "featureExtraction": ["OCR", "ASR", "visual_features", "audio_features", "text_embeddings", "image_text_embeddings", "temporal_features"],
    "fusion": ["late_fusion", "weighted_evidence_fusion", "cross_modal_embedding_fusion"],
    "derivedDataMustRetainInputHash": true,
    "originalMediaImmutable": true
  },
  "engines": {
    "mediaNormalizer": ["FFmpeg"],
    "pdfImageText": ["PDFium", "MuPDF", "PDFBox"],
    "ocr": ["OCRmyPDF", "Tesseract"],
    "imageFeatures": ["OpenCV"],
    "audioFeatures": ["librosa"],
    "asr": ["Whisper", "faster-whisper"],
    "forcedAlignment": ["Montreal Forced Aligner", "WhisperX-compatible adapter"],
    "crossModalEmbeddings": ["Sentence Transformers", "CLIP/SigLIP-compatible adapter"],
    "videoSegmentation": ["FFmpeg", "OpenCV"],
    "policy": ["rights-policy-engine", "privacy-policy-engine", "usage-constraint-engine"],
    "feedback": ["active-learning-queue", "human-review-dataset", "model-evaluation-loop"]
  },
  "manuscript": {
    "representation": "IIIF_PRESENTATION_3",
    "pageModel": ["image", "ocr", "transcription", "normalized_text", "translation", "annotation", "scholar_note", "citation", "confidence"],
    "derivedContentMustRemainLinkedToCanvas": true
  },
  "recitation": {
    "reference": "canonical_quran_arabic",
    "alignment": ["verse", "word", "media_time"],
    "tracking": ["surah", "ayah", "riwayah", "session", "confidence"],
    "analysis": ["omission", "addition", "substitution", "repetition", "hesitation", "boundary_drift", "tajweed_candidate"],
    "feedback": "learning_assistance_only",
    "religiousAuthority": false,
    "fatwaCapability": false,
    "canonicalTextMutation": false
  },
  "guardrails": {
    "rights": ["ALLOWED", "RESTRICTED", "UNKNOWN", "EXPLICIT_PERMISSION_REQUIRED"],
    "publishOnlyWhenAllowed": true,
    "unknownIsNotPublishable": true,
    "restrictedIsNotPublishable": true,
    "privacyExposureBlocked": true,
    "usageTermsViolationBlocked": true,
    "canonicalQuranMutationBlocked": true,
    "originalMediaMutationBlocked": true,
    "unsafeExternalExecutionBlocked": true
  },
  "humanReview": {
    "states": ["UNREVIEWED", "CANDIDATE", "HUMAN_REVIEWED", "VERIFIED", "REJECTED"],
    "requiredForAuthoritativeReligiousUse": true,
    "reviewerIdentityRequired": true,
    "evidenceReferencesRequired": true
  },
  "feedbackLoop": {
    "types": ["CORRECTION", "CONFIRMATION", "REJECTION", "BOUNDARY_ADJUSTMENT", "ALIGNMENT_CORRECTION", "TAJWEED_CORRECTION", "TRANSCRIPTION_CORRECTION"],
    "activeLearning": true,
    "evaluationRequiredBeforeDeployment": true,
    "automaticDeployment": false,
    "sourceCorpusMutation": false
  },
  "memorization": {
    "state": ["retention", "fluency", "accuracy", "confidence", "error_history", "mastery_status"],
    "adaptiveReview": true,
    "spacedReview": true
  },
  "multilingual": {
    "model": "CONCEPT_CENTRIC",
    "relations": ["EXACT_EQUIVALENT", "APPROXIMATE_EQUIVALENT", "HISTORICAL_EQUIVALENT", "SCHOOL_SPECIFIC_TERM", "TRANSLATION_VARIANT", "NO_EXACT_EQUIVALENT"],
    "lowResourceLanguagesAllowed": true,
    "originalTermPreserved": true
  },
  "pipelineBoundary": ["ACQUISITION", "VALIDATION", "RIGHTS", "PROVENANCE", "CORPUS", "KNOWLEDGE", "LEARNING", "RESEARCH"],
  "safety": {
    "originalPdfImmutable": true,
    "canonicalQuranArabicImmutable": true,
    "rightsCannotBeOverriddenByLearning": true,
    "knowledgeGraphCannotCreateSourceTrust": true,
    "recitationEngineCannotActAsInfallibleReligiousAuthority": true,
    "humanScholarReviewForAuthoritativeReligiousJudgment": true
  },
  "researchBasis": {
    "iiifPresentationApi3": "https://iiif.io/api/presentation/3.0/",
    "webAnnotationDataModel": "https://www.w3.org/TR/annotation-model/",
    "w3cProv": "https://www.w3.org/TR/prov-dm/",
    "premis": "https://www.loc.gov/standards/premis/v3/",
    "ffmpeg": "https://github.com/FFmpeg/FFmpeg",
    "montrealForcedAligner": "https://github.com/MontrealCorpusTools/Montreal-Forced-Aligner",
    "sentenceTransformers": "https://github.com/UKPLab/sentence-transformers",
    "transformers": "https://github.com/huggingface/transformers",
    "multimodalAlignmentSurvey": "arXiv:2411.17040",
    "multimodalRagSurvey": "arXiv:2502.08826",
    "activeLearningHumanInLoopSurvey": "arXiv:1910.02923"
  },
  "completion": {
    "unitTestsRequired": true,
    "integrationTestsRequired": true,
    "preprocessingEvidenceRequired": true,
    "rightsEvidenceRequired": true,
    "provenanceRequired": true,
    "guardrailDecisionRequired": true,
    "scholarReviewRequiredForAuthoritativeUse": true,
    "feedbackEvaluationRequiredBeforeModelDeployment": true,
    "globalV1V31PlusGateRequired": true
  }
}
