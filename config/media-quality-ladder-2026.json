{
  "version": "2026-08-30",
  "principle": "No application-imposed master-resolution ceiling.",
  "master": {"maxResolution": null, "preserveSourceNativeDetail": true, "upscaleLowerResolutionAsNative": false, "futureHigherResolutionsAllowed": true},
  "preferredDownloadTiers": ["24K","16K","12K","8K","4K"],
  "geometryPolicy": {"resolutionLabelIsNotUniversalPixelGeometry": true, "recordActualWidthAndHeight": true, "recordAspectRatio": true, "supportMultipleStandards": true},
  "selection": {"mode":"adaptive", "showOnlyExistingDerivatives":true, "considerViewerDevice":true, "considerNetwork":true, "allowManualQualityChoice":true, "neverAdvertiseUnavailableTier":true},
  "platformPublishing": {"mode":"capability-driven", "keepBestInternalMaster":true, "publishHighestActuallySupportedDerivative":true, "reprobePlatformCapabilities":"before-publish-and-when-platform-policy-changes"},
  "integrity": {"preserveNativeFrameRate":true,"preserveNativeAspectRatio":true,"preserveBitDepthWhenSupported":true,"preserveChromaFormatWhenSupported":true,"preserveColorPrimariesAndTransfer":true,"preserveHdrMetadataWhenPresent":true,"recordSourceDimensions":true,"recordDerivativeDimensions":true,"recordCodecAndProfile":true,"recordChecksum":true},
  "trueResolution": {"24KMeansNativeDetail":true,"forbidMisleadingUpscaleLabel":true,"requireDisplayValidationForPhysical24K":true,"physicalDisplayMayUseDocumentedTiling":true},
  "freeFirst": {"paidApiRequired":false,"subscriptionRequired":false,"externalPlatformAdaptersOptional":true}
}
