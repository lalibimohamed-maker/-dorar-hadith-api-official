# Production edge/origin security profile for the Deen Allah API.
# Copy these values into the deployment secret/environment configuration; do not commit secrets.

# Trust only a reverse proxy whose source addresses are explicitly allowlisted.
TRUST_PROXY=true
TRUST_PROXY_MODE=cloudflare
# Keep this list synchronized with the current Cloudflare published IPv4 ranges.
# For Cloudflare Tunnel, include the local loopback source and keep the tunnel as the only public ingress.
TRUSTED_PROXY_CIDRS=127.0.0.1/32

# Fail closed if the application is directly reached outside the trusted edge.
EDGE_ONLY=true

# Never use wildcard CORS in production unless the API is deliberately public to every origin.
# Comma-separated exact origins only.
CORS_ALLOWED_ORIGINS=https://example.org,https://www.example.org

# Request/resource exhaustion controls.
MAX_HEADER_BYTES=32768
MAX_REQUEST_BODY_BYTES=1048576
MAX_URL_BYTES=8192
MAX_QUERY_ARRAY_ITEMS=50
MAX_CONCURRENT_REQUESTS=256
ACCELERATION_MAX_PER_MINUTE=120
ACCELERATION_SENSITIVE_MAX_PER_MINUTE=20

# The public API remains anonymous; x-api-key is reserved for sensitive/internal routes.
PERFORMANCE_PUBLIC=false
