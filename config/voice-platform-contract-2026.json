{
  "schema": "dinullah.voice-platform-contract.v1",
  "assistant": "Al-Huda",
  "reference": "VoiceStudio",
  "sourceReferenceVersion": "0.5.6",
  "principles": {
    "localFirst": true,
    "noCorpusModification": true,
    "noImplicitRemote": true,
    "releasePresenceIsNotRuntimeProof": true
  },
  "transports": {
    "inProcess": "preferred",
    "loopbackHttp": "optional",
    "websocketStreaming": "optional",
    "mcp": "optional-local-agent-bridge",
    "jsonRpc": "optional-local-ipc-dictation-control",
    "cli": "optional-local",
    "nativeDictation": "optional-local-output-session"
  },
  "network": {
    "defaultBind": "127.0.0.1",
    "remoteWorkers": "explicit-opt-in",
    "remoteAuthentication": "short-lived-token-or-mtls",
    "secretsInUrls": false
  },
  "lifecycle": [
    "declared",
    "acquiring",
    "acquired",
    "checksum-verified",
    "license-reviewed",
    "loadable",
    "loaded",
    "inference-verified",
    "ready"
  ],
  "jobContract": {
    "idempotencyKeyRequired": true,
    "progressEvents": true,
    "checkpointing": true,
    "cancellation": true,
    "resumeRequiresManifestValidation": true
  },
  "streaming": {
    "asrEvents": [
      "started",
      "partial",
      "final",
      "completed",
      "failed"
    ],
    "ttsEvents": [
      "started",
      "chunk",
      "completed",
      "failed"
    ],
    "monotonicSequence": true,
    "externalProtocol": "voicestudio.speech.v1",
    "inputAudioEndMessage": {
      "type": "input_audio.end"
    },
    "sessionEnvelope": [
      "protocol",
      "session_id",
      "type"
    ],
    "finalKind": [
      "utterance",
      "summary"
    ]
  },
  "longForm": {
    "chunking": true,
    "checkpointPerChunk": true,
    "resumeAfterRestart": true,
    "preserveRenderedChunks": true
  },
  "runtimeHardening": {
    "crashIsolation": true,
    "crashLoopBackoff": true,
    "redactedDiagnostics": true,
    "resourceAwareRouting": true,
    "lazyModelLoading": true
  },
  "security": {
    "corpusReadOnly": true,
    "rightsGatesEnforced": true,
    "modelPathAllowlist": true,
    "localhostIsNotAuthentication": true
  },
  "audioBoundaries": {
    "quranArabicCanonicalTextImmutable": true,
    "quranRecitationOriginalAudioOnly": true,
    "noSyntheticVoiceForQuranRecitation": true
  },
  "nativeDictation": {
    "createSession": "POST :3902/v1/output/sessions",
    "insertText": "POST :3902/v1/output/sessions/{id}/insert",
    "cancelSession": "DELETE :3902/v1/output/sessions/{id}",
    "focusedDestinationExclusive": true,
    "staleSessionMustFail": true,
    "noCorpusMutation": true
  },
  "referenceAlignment": {
    "voiceStudio": "0.5.6",
    "streamingProtocol": "voicestudio.speech.v1",
    "apiCompatibility": "OpenAI-compatible audio endpoints",
    "localMcp": "/mcp/",
    "note": "Only documented transports are mirrored as Din Allah contracts; VoiceStudio is not a runtime dependency."
  },
  "discovery": {
    "protocol": "voicestudio.speech.v1",
    "backend": "GET :3900/.well-known/voicestudio-speech",
    "control": "GET :3902/.well-known/voicestudio-speech",
    "documentedOnly": true
  },
  "agentIdentity": {
    "mcpClientHeader": "X-OmniVoice-Client-Id",
    "explicitProfilePrecedence": true
  }
}
