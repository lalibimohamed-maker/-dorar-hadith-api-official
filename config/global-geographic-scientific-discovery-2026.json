  },
  "evidenceFusion": {
    "flow":"discovery -> source_resolution -> independent_verification -> claim_normalization -> quran_hadith_cross_reference -> evidence_graph",
    "claimClasses":["scientific_observation","scientific_consensus","scientific_hypothesis","historical_report","interpretive_link"],
    "religiousLinkRule":"Only present a connection between a scientific finding and Quran or hadith at the strength supported by the Islamic and scientific sources; never upgrade an interpretive link into established scientific fact automatically."
  },
  "qualityGates":[
    "source_identity_verified",
    "claim_supported_by_primary_or_authoritative_evidence",
    "independent_second_source_checked_when_feasible",
    "scientific_uncertainty_recorded",
    "quran_or_hadith_reference_verified_when_present",
    "manuscript_or_textual_variant_recorded_when_relevant",
    "provenance_manifest_complete",
    "human_review_before_production"
  ],
  "outputRule":"The encyclopedia search returns knowledge sources, not a scientific-video discovery feed. Video production remains an explicitly invoked separate studio workflow."
