  "knowledgeExtraction": {
    "inputTypes":["article","paper","dataset","institutional_report","interview","field_observation","manuscript","photograph_metadata"],
    "extract":["scientific_claims","observations","measurement_context","species_or_object_identity","location","date","researcher_or_creator","primary_source","uncertainty_and_limitations","citation_identifier","license_evidence"],
