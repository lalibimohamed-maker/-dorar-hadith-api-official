{
  "schemaVersion": "1.1.0",
  "purpose": "Free-first, provider-neutral fallback policy for Din Allah Encyclopedia.",
  "principles": {
    "freeFirst": true,
    "openSourcePreferred": true,
    "noPaidDependencyRequired": true,
    "neverSilentlyLowerScientificAssurance": true,
    "automaticFallbackAllowedForHealthAndAvailability": true,
    "automaticScholarlyPromotionForbidden": true,
    "betterMeansHigherVerifiedCapabilityNotJustPopularity": true,
    "modelWeightsMustBeLicenseCheckedSeparately": true
  },
  "selectionOrder": [
    "eligible_free",
    "verified_open_source",
    "compatible",
    "healthy",
    "current",
    "quality_score",
    "fallback_priority"
  ],
  "domains": {
    "book_preprocessing": {
      "primary": "scantailor-advanced",
      "parallel_candidates": ["opencv", "unpaper"],
      "minimum": "preserve_original_and_pass_page_visual_quality_gate"
    },
    "ocr": {
      "primary": "paddleocr",
      "fallbacks": ["tesseract-ocr", "kraken"],
      "orchestrator": "ocrmypdf",
      "minimum": "retain_source_image_and_verification_state",
      "consensus": "at_least_two_independent_ocr_candidates_for_normal_arabic_pages"
    },
    "pdf_rendering": {
      "primary": "poppler",
      "fallbacks": ["pypdfium2"],
      "minimum": "page_count_and_dimensions_must_be_preserved_or_recorded"
    },
    "pdf_structure": {
      "primary": "qpdf",
      "fallbacks": [],
      "minimum": "output_pdf_must_open_and_pass_structure_checks"
    },
    "image_conversion": {
      "primary": "imagemagick",
      "fallbacks": ["pillow"],
      "minimum": "no_unrequested_lossy_transcode"
    },
    "lossless_pdf_packaging": {
      "primary": "img2pdf",
      "fallbacks": [],
      "minimum": "preserve_input_image_quality"
    },
    "djvu": {
      "primary": "djvulibre",
      "fallbacks": [],
      "minimum": "conversion_is_recorded_and_original_is_preserved"
    },
    "image_restoration": {
      "primary": "real-esrgan",
      "fallbacks": [],
      "minimum": "model-license-check-and-no-invented-text-gate"
    },
    "malware": {
      "primary": "clamav",
      "fallbacks": ["yara-forge-core"],
      "minimum": "at_least_one_independent_malware_engine"
    },
    "malware_patterns": {
      "primary": "yara-forge-core",
      "fallbacks": ["clamav"],
      "minimum": "pattern_scan_or_safe_fail_closed"
    },
    "vulnerability_scanning": {
      "primary": "trivy",
      "fallbacks": ["npm-audit"],
      "minimum": "do_not_claim_complete_coverage_when_fallback_is_narrower"
    },
    "secrets": {
      "primary": "gitleaks",
      "fallbacks": [],
      "minimum": "fail_closed_if_no_equivalent_free_engine_is_available"
    },
    "javascript_dependencies": {
      "primary": "npm-audit",
      "fallbacks": [],
      "minimum": "fail_closed"
    },
    "speech_to_text": {
      "primary": "whisper-cpp",
      "fallbacks": ["faster-whisper"],
      "minimum": "language_and_model_provenance_required"
    },
    "source_discovery": {
      "primary": "official_and_institutional_sources",
      "fallbacks": ["public_research_indexes", "secondary_catalogs"],
      "minimum": "discovery_only_until_verified"
    }
  },
  "runtimeRules": {
    "healthWindowMinutes": 30,
    "maxAutomaticFallbackDepth": 3,
    "recheckPrimaryOnEveryScheduledCycle": true,
    "recordFallbackEvent": true,
    "recordEngineVersion": true,
    "recordWhyPrimaryWasSkipped": true,
    "restorePrimaryWhenHealthy": true,
    "doNotReplacePrimaryPermanentlyWithoutReview": true,
    "licenseGateBeforeActivation": true
  }
}
