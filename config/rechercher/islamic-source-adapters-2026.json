        "books",
        "articles",
        "fatwa",
        "audio",
        "video",
        "quran",
        "hadith",
        "pdf",
        "discovery"
      ],
      "authority": "islamic_content_platform",
      "runtime": "public",
      "status": "enabled"
    },
    {
      "id": "islamhouse-cdn",
      "name": "d1.islamhouse.com",
      "base_url": "https://d1.islamhouse.com/",
      "origins": [
        "https://d1.islamhouse.com"
      ],
      "kinds": [
        "pdf",
        "audio",
        "video",
        "downloads"
      ],
      "authority": "IslamHouse_delivery_origin",
      "runtime": "public",
      "status": "enabled"
    },
    {
