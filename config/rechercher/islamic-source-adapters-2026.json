      "origins": [
        "https://hadeethenc.com"
      ],
      "kinds": [
        "hadith",
        "hadith_explanation",
        "translations",
        "pdf",
        "api",
        "languages",
        "categories",
        "hadith_list",
        "hadith_record",
        "provenance"
      ],
      "authority": "primary_islamic_content",
      "runtime": "public-api",
      "status": "enabled",
      "api_base_url": "https://hadeethenc.com/api/v1",
      "api_endpoints": {
        "languages": "/languages",
        "categories": "/categories/list/?language={language}",
        "roots": "/categories/roots/?language={language}",
        "hadith_list": "/hadeeths/list/?language={language}&category_id={category_id}&page={page}&per_page={per_page}",
        "hadith_one": "/hadeeths/one/?language={language}&id={id}"
      },
      "api_auth": "none",
      "acquisition": "existing-hadeethenc-pdf-harvester",
      "release_policy": "translations may be republished only when HadeethEnc terms/version/attribution requirements are preserved; verify current terms at acquisition/release time",
      "rights_policy": {
        "kind": "explicit-redistribution-permission",
        "scope": "translated_content",
        "evidence_url": "https://hadeethenc.com/en/",
        "exclude_language_iso": [
          "ar"
        ],
        "conditions": [
          "no-modification-addition-or-deletion",
          "publisher-and-source-attribution",
          "version-number",
          "retain-transcript-information",
          "notify-source-of-translation-notes",
          "update-to-latest-source-version",
          "no-inappropriate-advertising"
        ]
      }
    },
