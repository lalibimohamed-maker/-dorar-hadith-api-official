{
  "schema": "rechercher/islamic-source-adapters/v1",
  "purpose": "Registry-driven Islamic source adapters. Existing providers remain enabled; additional verified Sunni-oriented and broad Islamic providers are additive. AI/search services are discovery and cross-reference tools only and are never treated as the religious source of generated text.",
  "policy": {
    "existing_six_preserved": true,
    "source_must_be_islamic_or_explicitly_islamic_content_provider": true,
    "ai_is_not_a_religious_source": true,
    "ai_generated_translation_is_never_promoted": true,
    "source_evidence_required_before_promotion": true,
    "rights_verified_per_item": true,
    "canonical_arabic_separate": true,
    "human_translation_separate_from_machine_translation": true,
    "no_new_pdf_enc": true,
    "additional_sunni_sources_added": true,
    "source_provenance_preserved": true
  },
