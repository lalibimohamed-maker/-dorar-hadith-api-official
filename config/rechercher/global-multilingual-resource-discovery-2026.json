  "discovery_method": {
    "phase_1": "Enumerate first-party language catalogues and official APIs.",
    "phase_2": "Normalize language names to ISO codes only after evidence-backed mapping.",
    "phase_3": "Intersect language sets across Quran, hadith, tafsir, books and terminology resources.",
    "phase_4": "Attach provenance, rights and verification state to every resource, not merely to the language.",
    "phase_5": "Execute all 48 configured Islamic knowledge domains for every evidence-backed language; domain 48 captures otherwise-unclassified Islamic knowledge and automatically classifies it by subject.",
    "phase_6": "Search regional, scholarly and institutional sources for languages underrepresented by the major global providers."
