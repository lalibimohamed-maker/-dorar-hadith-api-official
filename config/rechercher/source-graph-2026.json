      ],
      "status": "discovery-registry",
      "rights": "source-specific"
    },
    {
      "id": "islamhouse",
      "name": "IslamHouse",
      "url": "https://islamhouse.com/read#lang_ar",
      "role": "multilingual_islamic_content_discovery",
      "capabilities": [
        "books",
        "articles",
        "fatwas",
        "audio",
        "video",
        "quran",
        "hadith",
        "language_catalogue"
      ],
      "status": "runtime-verified",
      "rights": "item-level"
    }
  ],
  "runtime_policy": {
    "no_status_from_name_only": true,
    "runtime_verified_requires_executable_connector_and_tests": true,
    "iiif_runtime_capable_requires_manifest_url": true,
    "catalogue_search_is_distinct_from_manifest_retrieval": true,
    "rights_verified_per_item": true
  }
}
