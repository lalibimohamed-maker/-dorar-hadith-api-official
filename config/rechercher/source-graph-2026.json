      ],
      "status": "iiif-runtime-capable",
      "rights": "item-level",
      "runtime_note": "Manifest retrieval is implemented through the allowlisted IIIF connector; provider-specific catalogue search remains separate."
    },
    {
      "id": "openiti",
      "name": "OpenITI",
      "url": "https://openiti.org/",
      "role": "early_text_and_authority",
      "capabilities": [
        "machine_readable_text",
        "author_work_metadata"
      ],
      "status": "discovery-registry",
      "rights": "dataset-specific"
    },
    {
      "id": "shamela",
      "name": "Shamela",
      "url": "https://shamela.ws/",
      "role": "bibliographic_and_text_discovery",
      "capabilities": [
        "books",
        "sections",
