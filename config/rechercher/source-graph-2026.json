{
  "schema": "rechercher/source-graph/v1",
  "purpose": "System-layer authority and provenance graph for Islamic works, editions, manuscript witnesses, repositories, manifests, pages and passages. It never writes directly to Corpus.",
  "policy": {
    "corpus_write": "never-direct",
    "source_text_must_remain_at_source": true,
    "ai_is_not_a_source": true,
    "rights_verified_per_item": true,
    "canonical_arabic_separate_from_translations": true,
    "discovery_connector_distinct_from_content_connector": true
  },
  "node_types": [
    "work",
    "author",
    "edition",
    "manuscript_witness",
    "repository",
    "identifier",
    "iiif_manifest",
    "page_or_folio",
    "text",
    "passage",
    "scholar_statement"
  ],
  "edge_types": [
    "authored_by",
    "edition_of",
    "witness_of",
    "held_by",
    "identified_by",
    "has_manifest",
    "has_page",
    "contains_text",
    "contains_passage",
    "statement_from"
  ],
  "connectors": [
    {
      "id": "gallica-bnf",
      "name": "Gallica / BnF",
      "url": "https://gallica.bnf.fr/",
      "role": "provenance_and_iiif",
      "capabilities": [
        "catalogue_search",
        "iiif_image",
        "iiif_presentation",
        "ocr",
        "text_extraction",
        "document_metadata"
      ],
      "status": "runtime-verified",
      "rights": "item-level"
    },
    {
      "id": "vhmml",
      "name": "vHMML",
      "url": "https://www.vhmml.org/",
      "role": "manuscript_catalogue_and_iiif",
      "capabilities": [
        "manuscript_metadata",
        "reading_room",
        "iiif",
        "downloadable_metadata_json"
      ],
      "status": "iiif-runtime-capable",
      "rights": "metadata-cc-by-4.0-where-stated",
      "runtime_note": "Manifest retrieval is implemented through the allowlisted IIIF connector; provider-specific catalogue search remains separate."
    },
    {
      "id": "fihrist",
      "name": "Fihrist",
      "url": "https://www.fihrist.org.uk/",
      "role": "authority_and_catalogue",
      "capabilities": [
        "manuscript_catalogue",
        "authority_metadata"
      ],
      "status": "iiif-runtime-capable",
      "rights": "item-level",
      "runtime_note": "Manifest retrieval is implemented through the allowlisted IIIF connector; provider-specific catalogue search remains separate."
    },
    {
      "id": "leiden-collections",
      "name": "Leiden Collections",
      "url": "https://digitalcollections.universiteitleiden.nl/",
      "role": "manuscript_and_book_discovery",
      "capabilities": [
        "catalogue",
        "digitized_items"
      ],
      "status": "iiif-runtime-capable",
      "rights": "item-level",
      "runtime_note": "Manifest retrieval is implemented through the allowlisted IIIF connector; provider-specific catalogue search remains separate."
    },
    {
      "id": "princeton",
      "name": "Princeton University Library",
      "url": "https://library.princeton.edu/",
      "role": "manuscript_and_book_discovery",
      "capabilities": [
        "catalogue",
        "digitized_items"
      ],
      "status": "iiif-runtime-capable",
      "rights": "item-level",
      "runtime_note": "Manifest retrieval is implemented through the allowlisted IIIF connector; provider-specific catalogue search remains separate."
    },
    {
      "id": "cambridge",
      "name": "Cambridge University Library",
      "url": "https://www.lib.cam.ac.uk/",
      "role": "manuscript_and_book_discovery",
      "capabilities": [
        "catalogue",
        "digitized_items"
      ],
      "status": "iiif-runtime-capable",
      "rights": "item-level",
      "runtime_note": "Manifest retrieval is implemented through the allowlisted IIIF connector; provider-specific catalogue search remains separate."
    },
    {
      "id": "british-library",
      "name": "British Library",
      "url": "https://www.bl.uk/",
      "role": "manuscript_and_book_discovery",
      "capabilities": [
        "catalogue",
        "digitized_items"
      ],
      "status": "iiif-runtime-capable",
      "rights": "item-level",
      "runtime_note": "Manifest retrieval is implemented through the allowlisted IIIF connector; provider-specific catalogue search remains separate."
    },
    {
      "id": "qdl",
      "name": "Qatar Digital Library",
      "url": "https://www.qdl.qa/",
      "role": "manuscript_and_archive_discovery",
      "capabilities": [
        "catalogue",
        "digitized_items"
      ],
      "status": "iiif-runtime-capable",
      "rights": "item-level",
      "runtime_note": "Manifest retrieval is implemented through the allowlisted IIIF connector; provider-specific catalogue search remains separate."
    },
    {
      "id": "al-furqan",
      "name": "Al-Furqan Islamic Heritage Foundation",
      "url": "https://www.al-furqan.com/",
