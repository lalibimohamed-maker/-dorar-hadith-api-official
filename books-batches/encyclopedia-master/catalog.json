    "source_comparison": "compare every reachable candidate from A/B/C/D/... before selecting the canonical stored artifact",
    "provenance_preserved_for_all_candidates": true,
    "different_editions_are_not_deduplicated": true,
    "verified_pdfs_are_never_deleted": true,
    "queue_is_state_not_catalog": true
