{
  "schemaVersion": "1.0.0",
  "purpose": "Evidence-first manifest for ingesting real hadith corpus records into Din Allah Encyclopedia.",
  "policy": {
    "textMustHaveProvenance": true,
    "noSyntheticHadithText": true,
    "noAutomaticGradeSynthesis": true,
    "preserveScholarDisagreement": true,
    "licenseRequiredBeforeBulkIngestion": true
  },
  "sourcePriority": [
    "official_publisher_or_rightsholder",
    "verified_digital_edition",
    "trusted_secondary_index"
  ],
  "recordRequiredFields": [
    "hadithId",
    "sourceId",
    "reference",
    "text",
    "chain"
  ],
  "assessmentRequiredFields": [
    "hadithId",
    "scholarId",
    "sourceId",
    "reference",
    "text"
  ],
  "initialSourceTargets": [
