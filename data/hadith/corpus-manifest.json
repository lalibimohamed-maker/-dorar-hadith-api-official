    {"sourceId":"tirmidhi","name":"جامع الترمذي","domain":"hadith","status":"source-first"},
    {"sourceId":"nasai","name":"السنن الكبرى/الصغرى للنسائي","domain":"hadith","status":"source-first"},
    {"sourceId":"ibnmajah","name":"سنن ابن ماجه","domain":"hadith","status":"source-first"},
    {"sourceId":"muwatta","name":"موطأ مالك","domain":"hadith","status":"source-first"},
    {"sourceId":"ahmad","name":"مسند أحمد","domain":"hadith","status":"source-first"}
  ]
