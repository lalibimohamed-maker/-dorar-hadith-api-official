{
  "schema": "din-allah-encyclopedia/pdf-hygiene/v2",
  "scope": {
    "pdf_root": "artifacts/developer-review-vault",
    "recursive": true,
    "whole_recovered_encyclopedia_vault": true
  },
  "policy": {
    "automatic_delete": "none",
    "safe_duplicate_action": "quarantine_exact_sha256_duplicate_same_catalog_identity_only",
    "near_duplicates": "report_only",
    "same_bytes_different_catalog_identity": "report_only",
    "untracked_pdfs": "report_only",
    "quarantine": "reversible_and_auditable"
  },
  "counts": {
    "pdf_files_scanned": 0,
    "valid_pdf_files": 0,
    "invalid_pdf_signatures": 0,
    "unique_sha256_groups": 0,
    "exact_duplicate_groups": 0,
    "safe_redundant_copies_quarantined": 0,
    "ambiguous_duplicate_groups": 0,
    "untracked_pdf_files": 0,
    "remaining_active_pdfs": 0
  },
  "invalid_pdf_files": [],
  "exact_duplicate_groups": [],
  "quarantined": [],
  "ambiguous": [],
  "untracked_pdf_files": [],
  "remaining_active_pdfs": []
}